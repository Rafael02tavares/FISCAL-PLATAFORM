---
export const prerender = false;

import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import invoiceDetailScript from "../../../scripts/invoice-detail.ts?url";

const { id } = Astro.params;
---

<DashboardLayout
  title="Detalhe da nota"
  subtitle={`Visualizacao detalhada da nota fiscal ${id}`}
>
  <div class="page-header">
    <h2>Detalhe da nota</h2>
    <p>ID da nota: {id}</p>
  </div>

  <section class="card card--padded">
    <div id="invoice-detail" data-invoice-id={id}>Carregando dados da nota...</div>
  </section>

  <script type="module" src={invoiceDetailScript}></script>

  <style>
    #invoice-detail {
      display: grid;
      gap: 18px;
    }

    .invoice-meta-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      background:
        radial-gradient(circle at top left, rgba(14, 165, 233, 0.12), transparent 30%),
        linear-gradient(135deg, #ffffff, #f8fbff);
      padding: 18px;
      border-radius: 18px;
      border: 1px solid #d9e4f3;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.05);
    }

    .invoice-meta-grid > div {
      border-radius: 14px;
      border: 1px solid #e2e8f0;
      background: rgba(255, 255, 255, 0.92);
      padding: 14px;
    }

    .suggest-btn {
      background: linear-gradient(135deg, #0f766e, #2563eb);
      color: white;
      border: none;
      padding: 9px 16px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 700;
      transition: transform 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
      box-shadow: 0 12px 24px rgba(37, 99, 235, 0.2);
    }

    .suggest-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 28px rgba(37, 99, 235, 0.26);
    }

    .suggest-btn[disabled] {
      opacity: 0.8;
      cursor: wait;
    }

    .suggest-btn--secondary {
      background: linear-gradient(135deg, #f59e0b, #fb7185);
      box-shadow: 0 12px 24px rgba(245, 158, 11, 0.22);
    }

    .action-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .small-muted {
      font-size: 12px;
      color: #64748b;
      margin-top: 4px;
    }

    .suggestion-slot {
      padding: 14px 0 6px;
    }

    .suggestion-card {
      border: 1px solid #d8e4f0;
      border-radius: 24px;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.16), transparent 25%),
        linear-gradient(180deg, #ffffff, #f8fbff);
      padding: 20px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
    }

    .suggestion-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 18px;
    }

    .suggestion-heading strong {
      font-size: 1.15rem;
      color: #0f172a;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 6px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #0f766e;
    }

    .muted-line {
      color: #475569;
      font-size: 13px;
      margin-top: 4px;
    }

    .suggestion-summary {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }

    .summary-chip {
      display: grid;
      gap: 6px;
      padding: 14px 16px;
      border-radius: 16px;
      border: 1px solid transparent;
      background: #f8fafc;
    }

    .summary-chip strong {
      font-size: 15px;
      color: #0f172a;
    }

    .summary-chip__label {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #475569;
    }

    .summary-chip--neutral {
      border-color: #e2e8f0;
      background: #f8fafc;
    }

    .summary-chip--blue {
      border-color: #bfdbfe;
      background: linear-gradient(180deg, #eff6ff, #dbeafe);
    }

    .summary-chip--green {
      border-color: #bbf7d0;
      background: linear-gradient(180deg, #f0fdf4, #dcfce7);
    }

    .summary-chip--amber {
      border-color: #fde68a;
      background: linear-gradient(180deg, #fffbeb, #fef3c7);
    }

    .suggestion-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .compare-box {
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 18px;
      background: #f8fafc;
    }

    .compare-box h4 {
      margin-top: 0;
      margin-bottom: 14px;
      color: #0f172a;
    }

    .compare-box--source {
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .compare-box--result {
      background: linear-gradient(180deg, #f0fdfb, #ecfeff);
      border-color: #b6e4dd;
    }

    .compare-list {
      display: grid;
      gap: 10px;
    }

    .compare-row {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 10px 12px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(148, 163, 184, 0.2);
    }

    .compare-row span {
      color: #475569;
      font-size: 13px;
    }

    .compare-row strong {
      color: #0f172a;
      text-align: right;
      word-break: break-word;
    }

    .confidence-badge {
      padding: 10px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
      border: 1px solid transparent;
    }

    .confidence-high {
      background: #dcfce7;
      color: #166534;
      border-color: #86efac;
    }

    .confidence-medium {
      background: #fef3c7;
      color: #92400e;
      border-color: #fcd34d;
    }

    .confidence-low {
      background: #fee2e2;
      color: #991b1b;
      border-color: #fca5a5;
    }

    .tax-breakdown {
      margin-top: 18px;
      border-radius: 20px;
      padding: 18px;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: white;
    }

    .tax-breakdown__header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 14px;
    }

    .tax-breakdown__header h4 {
      margin: 0;
      font-size: 1rem;
    }

    .tax-breakdown__header span {
      color: rgba(226, 232, 240, 0.82);
      font-size: 13px;
    }

    .tax-pill-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 12px;
    }

    .tax-pill {
      display: grid;
      gap: 8px;
      padding: 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .tax-pill span {
      color: rgba(226, 232, 240, 0.8);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .tax-pill strong {
      font-size: 1rem;
    }

    .tax-pill--soft {
      background: rgba(14, 165, 233, 0.12);
      border-color: rgba(56, 189, 248, 0.28);
    }

    .loading-box {
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      color: #1d4ed8;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid #bfdbfe;
      font-weight: 700;
    }

    .error-box {
      background: linear-gradient(135deg, #fff1f2, #fee2e2);
      color: #991b1b;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid #fecaca;
    }

    .legal-section {
      margin-top: 18px;
    }

    .legal-basis-box {
      background: linear-gradient(180deg, #fffdf7, #fffaf0);
      border-color: #f3e8c8;
    }

    .legal-list {
      display: grid;
      gap: 12px;
    }

    .legal-item {
      border: 1px solid #f1e3b6;
      border-radius: 16px;
      padding: 14px;
      background: white;
      font-size: 14px;
      box-shadow: 0 10px 24px rgba(148, 163, 184, 0.08);
    }

    .legal-item div {
      margin: 4px 0;
    }

    @media (max-width: 900px) {
      .invoice-meta-grid,
      .suggestion-grid,
      .suggestion-summary,
      .tax-pill-grid {
        grid-template-columns: 1fr;
      }

      .invoice-meta-grid {
        grid-template-columns: 1fr 1fr;
      }

      .tax-breakdown__header,
      .suggestion-top,
      .compare-row {
        grid-template-columns: 1fr;
        display: grid;
      }

      .compare-row strong {
        text-align: left;
      }
    }

    @media (max-width: 640px) {
      .invoice-meta-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</DashboardLayout>
