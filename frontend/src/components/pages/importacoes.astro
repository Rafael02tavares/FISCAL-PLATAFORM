---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import importsScript from "../../scripts/importacoes.ts?url";
---

<DashboardLayout
  title="Importacoes"
  subtitle="Envie um ou varios XMLs de NF-e e acompanhe as notas processadas pela API"
>
  <div class="page-header">
    <h2>Importar XMLs de NF-e</h2>
    <p>O upload usa o endpoint autenticado `/invoices/upload` e permite importar varios XMLs em lote.</p>
  </div>

  <div class="grid grid--2">
    <section class="card card--padded">
      <form id="upload-form" class="grid gap-3.5">
        <label class="grid gap-2 font-semibold text-sm">
          Arquivos XML
          <input
            id="xml-file"
            type="file"
            accept=".xml,text/xml,application/xml"
            multiple
            required
            class="form-input-file"
          />
        </label>
        <p class="m-0 text-text-muted text-[13px]">
          Selecione um ou varios arquivos XML para processamento em lote.
        </p>
        <div class="flex gap-2.5 mt-1">
          <button
            type="submit"
            class="primary-button"
          >Enviar lote</button>
        </div>
      </form>
      <div id="upload-message" class="dashboard-note mt-3.5"></div>
    </section>

    <section class="card card--padded">
      <h3 class="section-title">Resumo do ambiente</h3>
      <div id="upload-session" class="dashboard-note">Verificando sessao e organizacao ativa...</div>
    </section>
  </div>

  <div class="h-[18px]"></div>

  <section class="card card--padded">
    <h3 class="section-title">Notas importadas</h3>
    <div id="upload-invoices" class="dashboard-note">Carregando notas...</div>
  </section>

  <script type="module" src={importsScript}></script>
</DashboardLayout>
