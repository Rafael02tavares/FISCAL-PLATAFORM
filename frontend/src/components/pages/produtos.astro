---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import produtosScript from "../../scripts/produtos.ts?url";
---

<DashboardLayout
  title="Catalogo consultavel de produtos"
  subtitle="Consulte a identidade fiscal do item e gere sugestoes por UF e regime tributario"
>
  <section class="catalog-hero">
    <div class="catalog-hero__copy">
      <span class="catalog-badge">Consulta de produtos</span>
      <h3>Busque o item, confira a identidade fiscal e gere a sugestao</h3>
      <p>
        Descricao, GTIN, NCM e CST formam a base fixa do item. A saida e sugerida pela UF e regime
        da organizacao.
      </p>
      <div class="catalog-hero__legend">
        <span><i class="legend-dot legend-dot--teal"></i>Identidade do item</span>
        <span><i class="legend-dot legend-dot--amber"></i>Qualidade da base</span>
        <span><i class="legend-dot legend-dot--sky"></i>Sugestao por contexto</span>
      </div>
    </div>

    <div class="catalog-hero__visual">
      <div class="insight-card">
        <span class="insight-card__label">Resumo da pagina</span>
        <div id="catalog-stats" class="insight-card__grid">
          <div class="dashboard-note">Carregando indicadores do catalogo...</div>
        </div>
      </div>
    </div>
  </section>

  <div class="catalog-grid">
    <section class="card card--padded">
      <div class="section-heading">
        <div>
          <span class="section-heading__eyebrow">Lista operacional</span>
          <h3>Produtos cadastrados</h3>
        </div>
        <p>Use a busca para localizar item por descricao, GTIN, NCM, CEST ou CST.</p>
      </div>

      <div class="consultation-shell">
        <form id="catalog-search-form" class="catalog-search-panel">
          <label for="catalog-product-filter">
            <span class="catalog-search-panel__label">Busca unica</span>
          </label>
          <div class="catalog-search-row">
            <input
              id="catalog-product-filter"
              class="catalog-search catalog-search--hero"
              type="text"
              placeholder="Digite descricao, GTIN, NCM, CFOP, CEST ou codigo interno..."
            />
            <button class="primary-button primary-button--ghost" type="submit">Consultar</button>
          </div>
          <span class="catalog-search-panel__hint">
            Dica: para grandes bases, digite parte da descricao ou o GTIN e pressione Enter.
          </span>
        </form>

        <div class="consultation-quick-actions">
          <button class="quick-chip quick-chip--active" type="button" data-product-filter="all">Todos</button>
          <button class="quick-chip" type="button" data-product-filter="missing_ncm">Sem NCM</button>
          <button class="quick-chip" type="button" data-product-filter="missing_cest">Sem CEST</button>
          <button class="quick-chip" type="button" data-product-filter="missing_gtin">Sem GTIN</button>
          <button class="quick-chip" type="button" data-product-filter="missing_cst">Sem CST</button>
          <button class="quick-chip" type="button" data-product-filter="missing_reform">Sem IBS/CBS</button>
        </div>

        <div id="catalog-search-summary" class="consultation-summary">
          Preparando contexto de consulta...
        </div>

        <div id="catalog-products-result" class="dashboard-note">Carregando produtos tributarios...</div>
        <div id="catalog-pagination" class="catalog-pagination" aria-label="Paginacao do catalogo fiscal"></div>
      </div>
    </section>

    <section class="side-column">
      <article class="card card--padded">
        <div class="section-heading section-heading--tight">
          <div>
            <span class="section-heading__eyebrow">Consulta guiada</span>
            <h3>Uso recomendado</h3>
          </div>
        </div>
        <div class="governance-grid">
          <article class="governance-card">
            <h4>Consulta por descricao</h4>
            <p>Use termos curtos: marca, produto, volume ou embalagem.</p>
          </article>
          <article class="governance-card">
            <h4>Consulta por codigo</h4>
            <p>GTIN localiza o item exato. NCM e CEST ajudam em revisoes por grupo fiscal.</p>
          </article>
          <article class="governance-card">
            <h4>Sugestao por contexto</h4>
            <p>A acao da tabela usa UF e regime da empresa ativa para sugerir a saida.</p>
          </article>
        </div>
      </article>

      <article class="card card--padded">
        <div class="section-heading section-heading--tight">
          <div>
            <span class="section-heading__eyebrow">Busca rapida</span>
            <h3>Panorama da base</h3>
          </div>
        </div>
        <div id="catalog-coverage" class="dashboard-note">Carregando comparativos...</div>
      </article>

      <article class="card card--padded">
        <div class="section-heading section-heading--tight">
          <div>
            <span class="section-heading__eyebrow">Governanca</span>
            <h3>Frentes tributarias</h3>
          </div>
        </div>
        <div id="catalog-governance" class="governance-grid"></div>
      </article>

      <details class="card card--padded catalog-admin-panel">
        <summary class="catalog-admin-panel__summary">
          <div>
            <span class="section-heading__eyebrow">Manutencao especializada</span>
            <h3>Cadastro tributario do produto</h3>
          </div>
          <p>Abra apenas quando precisar completar os dados fixos do item.</p>
        </summary>

        <form id="catalog-product-form" class="catalog-form">
          <input name="product_id" type="hidden" />

          <label>
            Codigo interno
            <input name="product_code" type="text" placeholder="SKU-001" />
          </label>

          <label>
            GTIN
            <input name="gtin" type="text" placeholder="7890000000000" />
          </label>

          <label class="full-width">
            Descricao
            <input name="description" type="text" placeholder="Detergente liquido 500ml" required />
          </label>

          <label>
            NCM
            <input name="ncm" type="text" placeholder="34025000" />
          </label>

          <label>
            NCM EX
            <input name="ncm_ex" type="text" placeholder="001" />
          </label>

          <label>
            CEST
            <input name="cest" type="text" placeholder="2804700" />
          </label>

          <label>
            cClasTrib
            <input name="cclas_trib" type="text" placeholder="123" />
          </label>

          <label>
            CSOSN
            <input name="csosn" type="text" placeholder="102" />
          </label>

          <label>
            ICMS CST
            <input name="icms_cst" type="text" placeholder="00" />
          </label>

          <label>
            PIS CST
            <input name="pis_cst" type="text" placeholder="01" />
          </label>

          <label>
            COFINS CST
            <input name="cofins_cst" type="text" placeholder="01" />
          </label>

          <label>
            Cod. rec. PIS
            <input name="pis_revenue_code" type="text" placeholder="8109" />
          </label>

          <label>
            Cod. rec. COFINS
            <input name="cofins_revenue_code" type="text" placeholder="2172" />
          </label>

          <input name="cfop" type="hidden" />
          <input name="cbenef" type="hidden" />
          <input name="icms_value" type="hidden" />
          <input name="ipi_value" type="hidden" />
          <input name="pis_value" type="hidden" />
          <input name="cofins_value" type="hidden" />
          <input name="pis_rate" type="hidden" />
          <input name="cofins_rate" type="hidden" />
          <input name="icms_rate" type="hidden" />
          <input name="icms_base_reduction" type="hidden" />
          <input name="fcp_rate" type="hidden" />
          <input name="icms_st_rate" type="hidden" />
          <input name="ibs_rate" type="hidden" />
          <input name="cbs_rate" type="hidden" />
          <input name="selective_tax_code" type="hidden" />
          <input name="selective_tax_rate" type="hidden" />
          <input name="operation_code" type="hidden" value="sale_consumer_final" />
          <input name="emitter_uf" type="hidden" />
          <input name="recipient_uf" type="hidden" />
          <input name="operation_nature" type="hidden" />
          <input name="target_tax_regime" type="hidden" />
          <input name="target_crt" type="hidden" />

          <div class="form-actions full-width">
            <button class="primary-button" type="submit">Salvar item fiscal</button>
            <button id="new-product-button" class="secondary-button" type="button">Novo produto</button>
            <p class="form-hint">O item fica disponivel para busca, sugestao fiscal e simulacao por UF/regime.</p>
          </div>
        </form>

        <div id="catalog-form-message" class="dashboard-note">Preparando cadastro tributario...</div>
      </details>
    </section>
  </div>

  <script type="module" src={produtosScript}></script>

  <style>
    :global(.page-filter) {
      display: none;
    }

    .catalog-hero,
    .catalog-grid {
      display: grid;
      gap: 18px;
      margin-bottom: 18px;
    }

    .catalog-hero {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 0.7fr);
      padding: 18px;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background:
        linear-gradient(90deg, rgba(240, 253, 250, 0.9), rgba(248, 251, 255, 0.96));
    }

    .catalog-grid {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .catalog-grid > .card,
    .catalog-grid > .side-column {
      min-width: 0;
    }

    .catalog-badge,
    .section-heading__eyebrow {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      background: #fef3c7;
      color: #92400e;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .catalog-hero__copy h3 {
      margin: 8px 0;
      font-size: clamp(22px, 2.2vw, 30px);
      line-height: 1.1;
    }

    .catalog-hero__copy p,
    .section-heading p,
    .product-card__meta,
    .metric-card p {
      margin: 0;
      color: #475569;
    }

    .catalog-hero__legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
      font-size: 12px;
      font-weight: 600;
      color: #475569;
    }

    .catalog-hero__legend span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      display: inline-block;
    }

    .legend-dot--teal { background: #0f766e; }
    .legend-dot--amber { background: #f59e0b; }
    .legend-dot--sky { background: #0ea5e9; }

    .catalog-hero__visual,
    .side-column {
      display: grid;
      gap: 18px;
      align-content: start;
    }

    .side-column {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .insight-card,
    .catalog-illustration {
      border: 1px solid #dbe4ee;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.92);
      padding: 12px;
    }

    .insight-card__label {
      display: inline-flex;
      margin-bottom: 8px;
      color: #0f172a;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .insight-card__grid,
    .governance-grid,
    .catalog-products-list,
    .catalog-field-grid {
      display: grid;
      gap: 12px;
    }

    .insight-card__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .catalog-illustration svg {
      width: 100%;
      height: auto;
      display: block;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: end;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .section-heading--tight {
      align-items: start;
    }

    .section-heading h3 {
      margin: 6px 0 0;
    }

    .catalog-form {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .catalog-form label {
      display: grid;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
      color: #0f172a;
    }

    .catalog-form input,
    .catalog-search {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      font: inherit;
      background: white;
    }

    .consultation-shell {
      display: grid;
      gap: 18px;
    }

    .catalog-search-panel {
      display: grid;
      gap: 8px;
      padding: 14px;
      border: 1px solid #dbe4ee;
      border-radius: 14px;
      background:
        linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .catalog-search-panel__label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #0f766e;
    }

    .catalog-search-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      align-items: center;
    }

    .catalog-search--hero {
      padding: 12px 14px;
      font-size: 15px;
      border-radius: 10px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
    }

    .catalog-search-panel__hint {
      color: #64748b;
      font-size: 13px;
    }

    .consultation-quick-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .quick-chip {
      display: inline-flex;
      appearance: none;
      padding: 6px 10px;
      border-radius: 8px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      color: #334155;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition:
        transform 150ms ease,
        border-color 150ms ease,
        background 150ms ease;
    }

    .quick-chip:hover {
      transform: translateY(-1px);
      border-color: #0ea5e9;
    }

    .quick-chip--active {
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
      border-color: transparent;
      color: white;
      box-shadow: 0 12px 24px rgba(15, 118, 110, 0.18);
    }

    .consultation-summary {
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid #dbe4ee;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
      color: #0f172a;
    }

    .consultation-summary strong {
      display: block;
      margin-bottom: 4px;
      font-size: 14px;
    }

    .catalog-pagination {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: center;
      padding: 16px;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(14, 165, 233, 0.08));
    }

    .catalog-pagination:empty {
      display: none;
    }

    .catalog-pagination__info {
      display: grid;
      gap: 4px;
      color: #475569;
      font-size: 13px;
    }

    .catalog-pagination__info strong {
      color: #0f172a;
      font-size: 15px;
    }

    .catalog-pagination__actions {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }

    .catalog-pagination button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .form-actions {
      display: flex;
      gap: 14px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 4px;
    }

    .primary-button {
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
      color: white;
      font: inherit;
      font-weight: 700;
      padding: 12px 18px;
      cursor: pointer;
      box-shadow: 0 16px 30px rgba(15, 118, 110, 0.18);
    }

    .secondary-button {
      border: 1px solid #cbd5e1;
      border-radius: 14px;
      background: white;
      color: #0f172a;
      cursor: pointer;
      font: inherit;
      font-weight: 800;
      padding: 12px 18px;
    }

    .secondary-button:hover {
      border-color: #0ea5e9;
      background: #f8fafc;
    }

    .primary-button--ghost {
      white-space: nowrap;
      box-shadow: none;
    }

    .form-hint {
      color: #64748b;
      font-size: 13px;
    }

    .metric-card,
    .coverage-card,
    .governance-card,
    .product-card,
    .tax-pill {
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .metric-card {
      padding: 10px;
      display: grid;
      gap: 4px;
    }

    .metric-card div:first-child {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: end;
    }

    .metric-card strong {
      font-size: 20px;
      color: #0f172a;
      line-height: 1;
    }

    .metric-card span {
      color: #475569;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .metric-card__bar {
      height: 6px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.24);
      overflow: hidden;
    }

    .metric-card__bar i {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
    }

    .metric-card--teal { background: #f0fdfa; }
    .metric-card--amber { background: #fffbeb; }
    .metric-card--sky { background: #eff6ff; }
    .metric-card--rose { background: #fff1f2; }

    .coverage-card,
    .governance-card {
      padding: 16px;
    }

    .product-table-wrap {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      border: 1px solid #94a3b8;
      border-radius: 6px;
      background: #ffffff;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
      -webkit-overflow-scrolling: touch;
    }

    .product-table {
      width: 100%;
      min-width: 1400px;
      border-collapse: collapse;
      table-layout: fixed;
      color: #0f172a;
      font-size: 13px;
    }

    .product-table__col-index { width: 50px; }
    .product-table__col-product { width: 320px; }
    .product-table__col-gtin { width: 150px; }
    .product-table__col-ncm { width: 190px; }
    .product-table__col-cest { width: 150px; }
    .product-table__col-icms { width: 120px; }
    .product-table__col-piscofins { width: 130px; }
    .product-table__col-reform { width: 110px; }
    .product-table__col-status { width: 140px; }
    .product-table__col-actions { width: 160px; }

    .product-table th {
      position: sticky;
      top: 0;
      z-index: 1;
      padding: 14px 16px;
      background: #f8fafc;
      border-bottom: 2px solid #cbd5e1;
      color: #334155;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-align: left;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .product-table td {
      height: 56px;
      padding: 12px 16px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: middle;
      font-size: 13px;
      line-height: 1.4;
    }

    .product-table__row--even td {
      background: #ffffff;
    }

    .product-table__row--odd td {
      background: #f8fafc;
    }

    .product-table tbody tr:hover td {
      background: #fff2cc;
    }

    .product-table td strong {
      display: block;
      color: #0f172a;
      font-size: 12px;
      font-weight: 800;
      line-height: 1.2;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .product-table td span {
      display: block;
      max-width: 100%;
      margin-top: 2px;
      color: #64748b;
      font-size: 11px;
      line-height: 1.25;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .product-table__product {
      min-width: 0;
    }

    .product-table__product strong {
      font-size: 12px;
    }

    :global(.product-table__ncm-code) {
      cursor: help;
      text-decoration: underline dotted #64748b 1px;
      text-underline-offset: 3px;
    }

    .product-table__index {
      background: #eef2f7 !important;
      color: #475569;
      font-weight: 800;
      text-align: center;
    }

    .product-table__actions {
      white-space: normal;
    }

    .product-table__actions button {
      width: 100%;
      margin: 0 0 4px;
      justify-content: center;
    }

    .product-table__row--saved td {
      background: #e2f0d9 !important;
      outline: 2px solid #6aa84f;
      outline-offset: -2px;
    }

    .product-table__details td {
      padding: 8px;
      background: #f8fafc;
      border: 1px solid #94a3b8;
    }

    .product-table__details .product-suggestion {
      margin-top: 4px;
    }

    .product-status-badge {
      display: inline-flex;
      width: 100%;
      justify-content: center;
      padding: 4px 6px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 900;
      white-space: nowrap;
    }

    .product-status-badge--teal {
      background: #ccfbf1;
      color: #115e59;
    }

    .product-status-badge--amber {
      background: #fef3c7;
      color: #92400e;
    }

    .product-status-badge--rose {
      background: #ffe4e6;
      color: #9f1239;
    }

    .coverage-card__bar {
      height: 10px;
      border-radius: 999px;
      background: #e2e8f0;
      overflow: hidden;
      margin-top: 8px;
    }

    .coverage-card__fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
    }

    .governance-card h4,
    .product-card h4 {
      margin: 0 0 8px;
    }

    .governance-card p,
    .product-card p {
      margin: 0;
      color: #64748b;
    }

    .product-card {
      padding: 18px;
      display: grid;
      gap: 16px;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 30%),
        linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .product-card--saved {
      border-color: #14b8a6;
      box-shadow:
        0 0 0 3px rgba(20, 184, 166, 0.12),
        0 24px 50px rgba(15, 118, 110, 0.16);
      animation: savedPulse 1200ms ease;
    }

    @keyframes savedPulse {
      0% {
        transform: translateY(-2px);
      }
      100% {
        transform: translateY(0);
      }
    }

    .catalog-admin-panel {
      overflow: hidden;
    }

    .catalog-admin-panel[open] {
      border-color: #cbd5e1;
    }

    .catalog-admin-panel__summary {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: start;
      cursor: pointer;
      list-style: none;
    }

    .catalog-admin-panel__summary::-webkit-details-marker {
      display: none;
    }

    .catalog-admin-panel__summary h3 {
      margin: 6px 0 0;
    }

    .catalog-admin-panel__summary p {
      margin: 0;
      max-width: 220px;
      color: #64748b;
      font-size: 13px;
    }

    .catalog-admin-panel[open] .catalog-form {
      margin-top: 18px;
    }

    .catalog-admin-panel[open] #catalog-form-message {
      margin-top: 16px;
    }

    .product-card__top,
    .product-card__footer {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      align-items: start;
    }

    .product-card__actions {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .product-edit-button,
    .product-suggest-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      cursor: pointer;
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      padding: 8px 12px;
      transition: all 150ms ease;
    }

    .product-suggest-button {
      border: none;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
      color: white;
      box-shadow: 0 4px 6px rgba(15, 118, 110, 0.15);
    }

    .product-edit-button {
      border: 1px solid #cbd5e1;
      background: white;
      color: #0f172a;
    }

    .product-edit-button:hover {
      border-color: #0ea5e9;
      background: #f8fafc;
    }

    .product-suggest-button:hover {
      box-shadow: 0 6px 12px rgba(15, 118, 110, 0.25);
      transform: translateY(-1px);
    }

    .product-card__top h4 {
      margin: 6px 0;
      color: #0f172a;
      font-size: 20px;
    }

    .product-card__scoreboard {
      display: grid;
      grid-template-columns: auto minmax(220px, 1fr) minmax(220px, 0.9fr);
      gap: 16px;
      align-items: center;
      padding: 16px;
      border: 1px solid #dbe4ee;
      border-radius: 22px;
      background:
        radial-gradient(circle at top left, rgba(15, 118, 110, 0.1), transparent 34%),
        linear-gradient(135deg, #ffffff, #f8fafc);
    }

    .product-radial {
      --score: 0;
      width: 112px;
      height: 112px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      align-content: center;
      background:
        radial-gradient(circle, #ffffff 0 56%, transparent 57%),
        conic-gradient(#0f766e calc(var(--score) * 1%), #e2e8f0 0);
      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.06);
    }

    .product-radial--amber {
      background:
        radial-gradient(circle, #ffffff 0 56%, transparent 57%),
        conic-gradient(#f59e0b calc(var(--score) * 1%), #e2e8f0 0);
    }

    .product-radial--rose {
      background:
        radial-gradient(circle, #ffffff 0 56%, transparent 57%),
        conic-gradient(#e11d48 calc(var(--score) * 1%), #e2e8f0 0);
    }

    .product-radial strong {
      margin-top: 10px;
      color: #0f172a;
      font-size: 24px;
      line-height: 1;
    }

    .product-radial span {
      color: #64748b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-status {
      display: grid;
      gap: 4px;
    }

    .product-status span {
      width: fit-content;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-status strong {
      color: #0f172a;
      font-size: 18px;
    }

    .product-status p {
      margin: 0;
      color: #64748b;
      font-size: 13px;
    }

    .product-status--teal span {
      background: #ccfbf1;
      color: #115e59;
    }

    .product-status--amber span {
      background: #fef3c7;
      color: #92400e;
    }

    .product-status--rose span {
      background: #ffe4e6;
      color: #9f1239;
    }

    .product-bars {
      display: grid;
      gap: 8px;
    }

    .product-bars span {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      color: #334155;
      font-size: 12px;
      font-weight: 800;
    }

    .product-bars span::after {
      content: "";
      display: block;
      height: 8px;
      border-radius: 999px;
      background: #e2e8f0;
    }

    .product-bars i {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 1;
      height: 8px;
      border-radius: 999px;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
    }

    .product-tax-map {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .product-tax-map--simple {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    }

    .product-main-facts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .fiscal-info-card {
      position: relative;
      display: grid;
      gap: 7px;
      min-height: 142px;
      padding: 16px;
      border: 1px solid #dbe4ee;
      border-radius: 22px;
      overflow: hidden;
      background: #ffffff;
    }

    .fiscal-info-card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 5px;
      background: #0f766e;
    }

    .fiscal-info-card span {
      color: #475569;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .fiscal-info-card strong {
      color: #0f172a;
      font-size: 18px;
      line-height: 1.15;
      overflow-wrap: anywhere;
    }

    .fiscal-info-card p {
      margin: 0;
      color: #475569;
      font-size: 13px;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .fiscal-info-card--teal {
      background: linear-gradient(180deg, #f0fdfa, #ffffff);
    }

    .fiscal-info-card--teal::before {
      background: #0f766e;
    }

    .fiscal-info-card--amber {
      background: linear-gradient(180deg, #fffbeb, #ffffff);
    }

    .fiscal-info-card--amber::before {
      background: #f59e0b;
    }

    .fiscal-info-card--sky {
      background: linear-gradient(180deg, #eff6ff, #ffffff);
    }

    .fiscal-info-card--sky::before {
      background: #0ea5e9;
    }

    .fiscal-info-card--rose {
      background: linear-gradient(180deg, #fff1f2, #ffffff);
    }

    .fiscal-info-card--rose::before {
      background: #e11d48;
    }

    .tax-section {
      display: grid;
      gap: 12px;
      padding: 16px;
      border: 1px solid #dbe4ee;
      border-radius: 22px;
      background: #ffffff;
      box-shadow: inset 4px 0 0 #0f766e;
    }

    .tax-section--sky {
      box-shadow: inset 4px 0 0 #0ea5e9;
      background: linear-gradient(180deg, #eff6ff, #ffffff);
    }

    .tax-section--teal {
      box-shadow: inset 4px 0 0 #0f766e;
      background: linear-gradient(180deg, #f0fdfa, #ffffff);
    }

    .tax-section--amber {
      box-shadow: inset 4px 0 0 #f59e0b;
      background: linear-gradient(180deg, #fffbeb, #ffffff);
    }

    .tax-section--rose {
      box-shadow: inset 4px 0 0 #e11d48;
      background: linear-gradient(180deg, #fff1f2, #ffffff);
    }

    .tax-section__title span {
      color: #0f172a;
      font-weight: 900;
    }

    .tax-section__title p {
      margin: 4px 0 0;
      color: #64748b;
      font-size: 13px;
    }

    .tax-section__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .field-item {
      display: grid;
      gap: 4px;
      padding: 11px 12px;
      border-radius: 16px;
      border: 1px solid #dbe4ee;
      background: rgba(255, 255, 255, 0.86);
    }

    .field-item small {
      color: #64748b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .field-item strong {
      color: #0f172a;
      font-size: 15px;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .field-item--teal {
      border-color: #99f6e4;
      background: #f0fdfa;
    }

    .field-item--amber {
      border-color: #fde68a;
      background: #fffbeb;
    }

    .field-item--sky {
      border-color: #bae6fd;
      background: #eff6ff;
    }

    .field-item--rose {
      border-color: #fecdd3;
      background: #fff1f2;
    }

    .product-chip {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      background: #e0f2fe;
      color: #075985;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .product-chip--source {
      background: #dcfce7;
      color: #166534;
    }

    .catalog-field-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .tax-pill {
      padding: 14px;
      display: grid;
      gap: 4px;
    }

    .tax-pill span {
      color: #64748b;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .tax-pill strong {
      color: #0f172a;
      font-size: 16px;
      line-height: 1.2;
    }

    .tax-pill--teal { background: #f0fdfa; }
    .tax-pill--amber { background: #fffbeb; }
    .tax-pill--sky { background: #eff6ff; }
    .tax-pill--rose { background: #fff1f2; }

    .product-suggestion {
      display: grid;
      gap: 12px;
      padding: 12px;
      border: 1px solid #94a3b8;
      border-left: 5px solid #0f766e;
      border-radius: 12px;
      background:
        radial-gradient(circle at top right, rgba(20, 184, 166, 0.12), transparent 28%),
        linear-gradient(135deg, #f8fbff, #ffffff);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .product-suggestion--empty,
    .product-suggestion--loading {
      border-style: dashed;
      border-color: #cbd5e1;
      background: #f8fafc;
    }

    .product-suggestion--error {
      border-color: #fecdd3;
      background: #fff1f2;
      color: #991b1b;
    }

    .product-suggestion p,
    .product-suggestion strong {
      margin: 0;
    }

    .product-suggestion__header {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: start;
      flex-wrap: wrap;
      padding-bottom: 10px;
      border-bottom: 2px solid #e2e8f0;
    }

    .product-suggestion__header span {
      color: #0f766e;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-suggestion__header strong {
      display: block;
      margin: 4px 0;
      color: #0f172a;
      font-size: 18px;
    }

    .product-suggestion__header p {
      color: #475569;
      line-height: 1.35;
    }

    .product-suggestion__groups {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }

    .suggestion-group {
      overflow: hidden;
      border: 1px solid #cbd5e1;
      border-top: 4px solid #0f766e;
      border-radius: 10px;
      background: #ffffff;
    }

    .suggestion-group h5 {
      margin: 0;
      padding: 8px 10px;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
      color: #0f172a;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .suggestion-group > div {
      display: grid;
      gap: 6px;
      padding: 8px;
    }

    .suggestion-group--teal { border-top-color: #0f766e; }
    .suggestion-group--amber { border-top-color: #f59e0b; }
    .suggestion-group--sky { border-top-color: #0284c7; }
    .suggestion-group--rose { border-top-color: #e11d48; }

    .suggestion-pill {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      min-height: 38px;
      padding: 6px 8px;
      border: 1px solid #dbe4ee;
      border-left: 4px solid #0f766e;
      border-radius: 7px;
      background: #ffffff;
    }

    .suggestion-pill small {
      color: #64748b;
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .suggestion-pill strong {
      color: #0f172a;
      font-size: 13px;
      text-align: right;
      word-break: break-word;
    }

    .suggestion-pill--teal {
      border-left-color: #0f766e;
      background: #f0fdfa;
    }

    .suggestion-pill--amber {
      border-left-color: #f59e0b;
      background: #fffbeb;
    }

    .suggestion-pill--sky {
      border-left-color: #0284c7;
      background: #eff6ff;
    }

    .suggestion-pill--rose {
      border-left-color: #e11d48;
      background: #fff1f2;
    }

    .product-suggestion__warnings {
      display: grid;
      gap: 0;
      overflow: hidden;
      border: 1px solid #f59e0b;
      border-left: 5px solid #f59e0b;
      border-radius: 10px;
      background: #fffbeb;
    }

    .product-suggestion__warnings strong {
      padding: 8px 12px;
      color: #92400e;
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .product-suggestion__warnings p {
      padding: 9px 12px;
      border-top: 1px solid #fde68a;
      color: #92400e;
      font-size: 13px;
      line-height: 1.35;
    }

    :global(.product-table__details .product-suggestion) {
      display: grid;
      gap: 10px;
      padding: 12px;
      border: 1px solid #94a3b8;
      border-left: 5px solid #0f766e;
      border-radius: 8px;
      background: #ffffff;
    }

    :global(.product-table__details .product-suggestion__header) {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      padding-bottom: 10px;
      border-bottom: 2px solid #dbe4ee;
    }

    :global(.product-table__details .product-suggestion__header span:first-child) {
      color: #0f766e;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    :global(.product-table__details .product-suggestion__header strong) {
      display: block;
      margin: 2px 0 4px;
      color: #0f172a;
      font-size: 15px;
      line-height: 1.2;
    }

    :global(.product-table__details .product-suggestion__header p) {
      margin: 0;
      color: #475569;
      font-size: 12px;
      line-height: 1.35;
    }

    :global(.suggestion-tax-table) {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      font-size: 12px;
    }

    :global(.suggestion-tax-table th),
    :global(.suggestion-tax-table td) {
      padding: 0;
      border: 1px solid #cbd5e1;
      vertical-align: top;
    }

    :global(.suggestion-tax-table th) {
      width: 165px;
      padding: 10px 12px;
      color: #0f172a;
      font-size: 12px;
      font-weight: 900;
      text-align: left;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      background: #f8fafc;
    }

    :global(.suggestion-tax-row--teal th) {
      border-left: 5px solid #0f766e;
      background: #f0fdfa;
    }

    :global(.suggestion-tax-row--sky th) {
      border-left: 5px solid #0284c7;
      background: #eff6ff;
    }

    :global(.suggestion-tax-row--rose th) {
      border-left: 5px solid #e11d48;
      background: #fff1f2;
    }

    :global(.suggestion-tax-row--amber th) {
      border-left: 5px solid #f59e0b;
      background: #fffbeb;
    }

    :global(.suggestion-tax-table td) {
      display: grid;
      grid-template-columns: repeat(4, minmax(120px, 1fr));
      gap: 0;
      background: #ffffff;
    }

    :global(.suggestion-cell) {
      display: grid;
      gap: 2px;
      min-height: 48px;
      padding: 8px 10px;
      border-right: 1px solid #e2e8f0;
    }

    :global(.suggestion-cell:last-child) {
      border-right: 0;
    }

    :global(.suggestion-cell small) {
      color: #64748b;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    :global(.suggestion-cell strong) {
      color: #0f172a;
      font-size: 13px;
      font-weight: 900;
      line-height: 1.2;
      word-break: break-word;
    }

    :global(.product-table__details .product-suggestion__warnings) {
      display: grid;
      gap: 0;
      overflow: hidden;
      border: 1px solid #f59e0b;
      border-left: 5px solid #f59e0b;
      border-radius: 6px;
      background: #fffbeb;
    }

    :global(.product-table__details .product-suggestion__warnings strong) {
      padding: 7px 10px;
      color: #92400e;
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    :global(.product-table__details .product-suggestion__warnings p) {
      margin: 0;
      padding: 8px 10px;
      border-top: 1px solid #fde68a;
      color: #92400e;
      font-size: 12px;
      line-height: 1.35;
    }

    :global(.product-ai-assist) {
      display: grid;
      gap: 10px;
      padding: 12px;
      border-radius: 12px;
      border: 1px solid #99f6e4;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.12), transparent 30%),
        linear-gradient(180deg, #f0fdfa, #ffffff);
    }

    :global(.product-ai-assist span) {
      color: #0f766e;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    :global(.product-ai-assist strong),
    :global(.product-ai-assist p) {
      margin: 0;
    }

    :global(.product-ai-assist__meta) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    :global(.product-ai-assist__meta span) {
      display: grid;
      gap: 4px;
      padding: 8px;
      border-radius: 10px;
      background: #ffffff;
      border: 1px solid #ccfbf1;
      color: #64748b;
      letter-spacing: normal;
      text-transform: none;
    }

    :global(.product-ai-assist__meta strong) {
      color: #0f172a;
      font-size: 13px;
    }

    :global(.product-ai-assist__signals) {
      color: #475569;
      line-height: 1.45;
    }

    .product-diagnostic {
      display: grid;
      gap: 12px;
      padding: 16px;
      border-radius: 20px;
      border: 1px solid #cbd5e1;
      background:
        radial-gradient(circle at top right, rgba(20, 184, 166, 0.12), transparent 32%),
        linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .product-diagnostic__header {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: start;
      flex-wrap: wrap;
    }

    .product-diagnostic__header span,
    .product-diagnostic-card span {
      color: #64748b;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-diagnostic__header strong {
      display: block;
      margin-top: 4px;
      color: #0f172a;
      font-size: 22px;
    }

    .product-diagnostic__counts {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
    }

    .product-diagnostic__counts span {
      padding: 7px 10px;
      border-radius: 999px;
      background: #f1f5f9;
      color: #334155;
      letter-spacing: 0;
      text-transform: none;
    }

    .product-diagnostic__bar {
      height: 10px;
      border-radius: 999px;
      background: #e2e8f0;
      overflow: hidden;
    }

    .product-diagnostic__bar div {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
    }

    .product-diagnostic__grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
    }

    .product-diagnostic-card {
      display: grid;
      gap: 6px;
      padding: 12px;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
    }

    .product-diagnostic-card--ready {
      border-color: #99f6e4;
      background: linear-gradient(180deg, #f0fdfa, #ffffff);
    }

    .product-diagnostic-card--attention {
      border-color: #fde68a;
      background: linear-gradient(180deg, #fffbeb, #ffffff);
    }

