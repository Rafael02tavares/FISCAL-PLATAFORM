---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Consulta tributaria"
  subtitle="Consulte a sugestao fiscal completa por descricao, GTIN, NCM e contexto operacional"
>
  <div class="page-header">
    <h2>Consulta tributaria assistida</h2>
    <p>
      Informe o item e consulte. Se voce nao preencher operacao e UFs, a plataforma usa venda a
      consumidor final na UF da organizacao ativa.
    </p>
  </div>

  <section class="simulation-hero">
    <div>
      <span class="simulation-badge">Consulta principal</span>
      <h3>Encontre a tributacao sugerida com leitura tecnica e comparativos claros</h3>
      <p>
        O motor cruza catalogo de produtos, operacao fiscal, CFOP sugerido e base legal para
        entregar uma sugestao pronta para analise.
      </p>
      <div class="simulation-legend">
        <span><i class="legend-dot legend-dot--teal"></i>Cadastro fiscal</span>
        <span><i class="legend-dot legend-dot--amber"></i>Aliquotas e incidencia</span>
        <span><i class="legend-dot legend-dot--sky"></i>Fluxo operacional</span>
      </div>
    </div>

    <div class="simulation-hero__visual">
        <div class="simulation-score-card">
        <span>Consulta fiscal</span>
        <strong id="simulation-score">Pronta para consultar</strong>
        <p id="simulation-score-detail">Informe descricao, GTIN ou NCM para cruzar produto, operacao e regras fiscais.</p>
        </div>

      <div class="simulation-illustration" aria-hidden="true">
        <svg viewBox="0 0 320 210" role="img">
          <defs>
            <linearGradient id="simGradientA" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0f766e"></stop>
              <stop offset="100%" stop-color="#0ea5e9"></stop>
            </linearGradient>
            <linearGradient id="simGradientB" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#f59e0b"></stop>
              <stop offset="100%" stop-color="#fb7185"></stop>
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="280" height="170" rx="24" fill="#ffffff" stroke="#dbe4ee"></rect>
          <rect x="44" y="46" width="96" height="18" rx="9" fill="#ccfbf1"></rect>
          <rect x="44" y="76" width="150" height="11" rx="5.5" fill="#e2e8f0"></rect>
          <rect x="44" y="98" width="120" height="11" rx="5.5" fill="#e2e8f0"></rect>
          <path d="M58 154 C110 120, 156 176, 220 120 S258 96, 280 68" fill="none" stroke="url(#simGradientB)" stroke-width="9" stroke-linecap="round"></path>
          <circle cx="58" cy="154" r="8" fill="#f59e0b"></circle>
          <circle cx="220" cy="120" r="8" fill="#fb7185"></circle>
          <circle cx="280" cy="68" r="8" fill="#0ea5e9"></circle>
          <circle cx="234" cy="92" r="38" fill="none" stroke="#e2e8f0" stroke-width="16"></circle>
          <circle cx="234" cy="92" r="38" fill="none" stroke="url(#simGradientA)" stroke-width="16" stroke-linecap="round" stroke-dasharray="162 76" transform="rotate(-90 234 92)"></circle>
        </svg>
      </div>
    </div>
  </section>

  <div class="simulation-grid">
    <section class="card card--padded">
      <div class="section-heading">
        <div>
          <span class="section-heading__eyebrow">Entrada da consulta</span>
          <h3>Preencha so o essencial</h3>
        </div>
      </div>

      <form id="simulation-form" class="simulation-form">
        <label class="full-width">
          Descricao do item
          <input id="description" type="text" placeholder="Cafe torrado e moido 500g" />
        </label>

        <label>
          GTIN
          <input id="gtin" type="text" placeholder="7890000000000" />
        </label>

        <label>
          NCM
          <input id="ncm-code" type="text" placeholder="09012100" />
        </label>

        <div class="full-width consultation-defaults" id="consultation-defaults">
          <strong>Contexto automatico da consulta</strong>
          <p id="consultation-defaults-text">
            Se nada for preenchido, a consulta usa venda a consumidor final e a UF da organizacao ativa.
          </p>
        </div>

        <details class="full-width consultation-advanced">
          <summary>Ajustar contexto da consulta</summary>
          <div class="consultation-advanced__grid">
            <label>
              Operacao fiscal
              <select id="operation-code">
                <option value="">Venda a consumidor final (padrao)</option>
              </select>
            </label>

            <label>
              Regime tributario
              <select id="tax-regime">
                <option value="">Usar regime da organizacao</option>
                <option value="simples_nacional">Simples Nacional</option>
                <option value="lucro_presumido">Lucro Presumido</option>
                <option value="lucro_real">Lucro Real</option>
              </select>
            </label>

            <label>
              CRT
              <select id="target-crt">
                <option value="">Usar CRT da organizacao</option>
                <option value="1">1 - Simples Nacional</option>
                <option value="2">2 - Simples excesso sublimite</option>
                <option value="3">3 - Regime Normal</option>
              </select>
            </label>

            <label>
              UF emitente
              <input id="emitter-uf" type="text" maxlength="2" placeholder="UF da organizacao" />
            </label>

            <label>
              UF destinatario
              <input id="recipient-uf" type="text" maxlength="2" placeholder="UF da organizacao" />
            </label>
          </div>
        </details>

        <div class="form-actions full-width">
          <button class="primary-button" type="submit">Consultar tributacao</button>
          <p class="form-hint">A consulta usa o motor real da API e aproveita a memoria tributaria consolidada.</p>
        </div>
      </form>

      <div id="simulation-message" class="dashboard-note">
        Faca login, selecione uma organizacao e envie uma consulta para acionar o motor fiscal.
      </div>
    </section>

    <section class="side-column">
      <article class="card card--padded">
        <div class="section-heading section-heading--tight">
          <div>
            <span class="section-heading__eyebrow">Rotas de consulta</span>
            <h3>Como ler o retorno</h3>
          </div>
        </div>
        <div class="comparison-guide">
          <article class="comparison-guide__card">
            <strong>Descricao ou GTIN</strong>
            <p>Use quando o foco for descobrir a melhor tributacao para um item ja conhecido.</p>
          </article>
          <article class="comparison-guide__card">
            <strong>NCM e operacao</strong>
            <p>Use para validar classificacao, CFOP sugerido, CST e contribuicoes por contexto.</p>
          </article>
          <article class="comparison-guide__card">
            <strong>Comparativo tecnico</strong>
            <p>O radar abaixo mostra classificacao, ICMS, PIS, COFINS e dados da reforma em paralelo.</p>
          </article>
        </div>
      </article>

      <article class="card card--padded">
        <div class="section-heading section-heading--tight">
          <div>
            <span class="section-heading__eyebrow">Comparativo</span>
            <h3>Radar da sugestao</h3>
          </div>
        </div>
        <div id="simulation-comparison" class="dashboard-note">
          Aguardando uma consulta para montar os comparativos de classificacao e incidencia.
        </div>
      </article>

      <article class="card card--padded">
        <div class="section-heading section-heading--tight">
          <div>
            <span class="section-heading__eyebrow">Base legal</span>
            <h3>Rastreabilidade</h3>
          </div>
        </div>
        <div id="simulation-legal-basis" class="dashboard-note">
          As referencias legais aplicadas aparecerao aqui apos a consulta.
        </div>
      </article>
    </section>
  </div>

  <section class="card card--padded">
    <div class="section-heading section-heading--tight">
      <div>
        <span class="section-heading__eyebrow">Resultado consolidado</span>
        <h3>Painel da consulta tributaria</h3>
      </div>
    </div>
    <div id="simulation-result" class="dashboard-note">
      A consulta vai mostrar classificacao, CST, aliquotas, fluxo operacional e reforma em um unico painel.
    </div>
  </section>

  <script type="module">
    import { listCatalogProducts } from "../../lib/catalog-products";
    import { listFiscalOperations } from "../../lib/fiscaloperations";
    import { listOrganizations } from "../../lib/organizations";
    import { suggestTax } from "../../lib/tax";

    const form = document.getElementById("simulation-form");
    const operationSelect = document.getElementById("operation-code");
    const defaultsText = document.getElementById("consultation-defaults-text");
    const result = document.getElementById("simulation-result");
    const message = document.getElementById("simulation-message");
    const comparison = document.getElementById("simulation-comparison");
    const legalBasisBox = document.getElementById("simulation-legal-basis");
    const score = document.getElementById("simulation-score");
    const scoreDetail = document.getElementById("simulation-score-detail");
    const LEGAL_RULE_DRAFT_KEY = "legal_rule_prefill";

    function readStorage(key) {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    }

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function hasValue(value) {
      return String(value || "").trim() !== "";
    }

    function displayValue(value, fallback = "Nao informado") {
      return hasValue(value) ? escapeHtml(value) : fallback;
    }

    function hasSuggestionPayload(payload) {
      const suggestion = payload?.suggestion || {};
      return [
        suggestion.ncm,
        suggestion.ncm_ex,
        suggestion.cest,
        suggestion.cclas_trib,
        suggestion.cfop,
        suggestion.csosn,
        suggestion.icms_cst,
        suggestion.pis_cst,
        suggestion.cofins_cst,
        suggestion.icms_rate,
        suggestion.pis_rate,
        suggestion.cofins_rate,
        suggestion.ipi_cst,
        suggestion.ipi_rate,
        suggestion.ipi_cenq,
        suggestion.ibs_rate,
        suggestion.cbs_rate,
        suggestion.selective_tax_code,
      ].some(hasValue);
    }

    function renderNotFoundState(term) {
      const safeTerm = displayValue(term, "consulta informada");

      if (comparison) {
        comparison.innerHTML = `
          <div class="dashboard-empty">
            <strong>Nenhum comparativo disponivel.</strong>
            <p>Nao encontramos memoria fiscal suficiente para ${safeTerm}.</p>
          </div>
        `;
      }

      if (legalBasisBox) {
        legalBasisBox.innerHTML = `
          <div class="dashboard-empty">
            <strong>Nenhuma regra localizada.</strong>
            <p>Cadastre o produto, importe uma nota ou informe um NCM para fortalecer a consulta.</p>
          </div>
        `;
      }

      if (result) {
        result.innerHTML = `
          <div class="dashboard-empty dashboard-empty--error">
            <strong>Nenhum perfil tributario encontrado.</strong>
            <p>A busca por ${safeTerm} nao encontrou um produto no catalogo nem memoria suficiente para montar a sugestao.</p>
          </div>
        `;
      }

      if (score) {
        score.textContent = "Sem correspondencia";
      }
      if (scoreDetail) {
        scoreDetail.textContent = "Cadastre o produto ou importe uma nota para alimentar o motor tributario.";
      }
    }

    async function resolveCatalogMatch(description) {
      const normalized = String(description || "").trim();
      if (!normalized) {
        return null;
      }

      try {
        const response = await listCatalogProducts(normalized);
        const items = Array.isArray(response?.items) ? response.items : [];
        return items[0] || null;
      } catch {
        return null;
      }
    }

    function setMessage(text, tone = "muted") {
      if (!message) return;
      message.textContent = text;
      message.className =
        tone === "error"
          ? "message-box message-box--error"
          : tone === "success"
            ? "message-box message-box--success"
            : "dashboard-note";
    }

    function pill(label, value, tone = "teal") {
      return `
        <div class="tax-pill tax-pill--${tone}">
          <span>${label}</span>
          <strong>${displayValue(value)}</strong>
        </div>
      `;
    }

    function fiscalCell(label, value) {
      return `
        <span class="simulation-tax-cell">
          <small>${label}</small>
          <strong>${displayValue(value)}</strong>
        </span>
      `;
    }

    function fiscalRow(title, tone, cells) {
      return `
        <tr class="simulation-tax-row simulation-tax-row--${tone}">
          <th scope="row">${title}</th>
          <td>${cells.join("")}</td>
        </tr>
      `;
    }

    function renderSimulationTaxTable(suggestion) {
      return `
        <table class="simulation-tax-table">
          <tbody>
            ${fiscalRow("Identidade fiscal", "teal", [
              fiscalCell("NCM", suggestion.ncm),
              fiscalCell("NCM EX", suggestion.ncm_ex),
              fiscalCell("CEST", suggestion.cest),
              fiscalCell("cClasTrib", suggestion.cclas_trib),
            ])}
            ${fiscalRow("Operacao e ICMS", "sky", [
              fiscalCell("CFOP", suggestion.cfop),
              fiscalCell("CSOSN", suggestion.csosn),
              fiscalCell("ICMS CST", suggestion.icms_cst),
              fiscalCell("Aliq. ICMS", suggestion.icms_rate),
            ])}
            ${fiscalRow("DIFAL e FCP", "amber", [
              fiscalCell("Aliq. interna UF", suggestion.difal_internal_rate),
              fiscalCell("Aliq. interestadual", suggestion.difal_interstate_rate),
              fiscalCell("Dif. DIFAL", suggestion.difal_difference_rate),
              fiscalCell("FCP", suggestion.fcp_rate),
            ])}
            ${fiscalRow("PIS e COFINS", "rose", [
              fiscalCell("PIS CST", suggestion.pis_cst),
              fiscalCell("COFINS CST", suggestion.cofins_cst),
              fiscalCell("Aliq. PIS", suggestion.pis_rate),
              fiscalCell("Aliq. COFINS", suggestion.cofins_rate),
            ])}
            ${fiscalRow("IPI", "amber", [
              fiscalCell("IPI CST", suggestion.ipi_cst),
              fiscalCell("Aliq. IPI", suggestion.ipi_rate),
              fiscalCell("CEnq IPI", suggestion.ipi_cenq),
              fiscalCell("Valor IPI", suggestion.ipi_value),
            ])}
            ${fiscalRow("Reforma", "teal", [
              fiscalCell("IBS", suggestion.ibs_rate),
              fiscalCell("CBS", suggestion.cbs_rate),
              fiscalCell("Imp. seletivo", suggestion.selective_tax_code),
              fiscalCell("Aliq. seletivo", suggestion.selective_tax_rate),
            ])}
          </tbody>
        </table>
      `;
    }

    function renderComparison(payload) {
      if (!comparison) return;

      const suggestion = payload?.suggestion || {};
      const cestReference = payload?.cest_reference || null;
      comparison.innerHTML = `
        <div class="simulation-tax-panel">
          ${renderSimulationTaxTable(suggestion)}
          ${
            cestReference
              ? `
                <article class="comparison-card comparison-card--accent simulation-tax-reference">
                  <h4>Referencia CEST</h4>
                  <p>${displayValue(cestReference.code)} | ${displayValue(cestReference.segment)} | NCM ${displayValue(cestReference.ncm_code)}</p>
                </article>
              `
              : ""
          }
        </div>
      `;
    }

    function renderLegalBasis(payload) {
      if (!legalBasisBox) return;

      const items = Array.isArray(payload?.legal_basis) ? payload.legal_basis : [];
      const retailDefaults = items.filter((item) => item?.tax_type === "RETAIL_DEFAULT");
      const legalItems = items.filter((item) => item?.tax_type !== "RETAIL_DEFAULT");
      const warnings = Array.isArray(payload?.warnings) ? payload.warnings : [];
      if (!items.length) {
        legalBasisBox.innerHTML = `
          <div class="legal-basis-stack">
            ${
              warnings.length
                ? `
                  <div class="warning-list">
                    ${warnings.map((warning) => `<p>${escapeHtml(warning)}</p>`).join("")}
                  </div>
                `
                : ""
            }
            <div class="dashboard-empty">
              <strong>Nenhuma regra legal especifica retornada.</strong>
              <p>A sugestao foi montada principalmente com base no catalogo fiscal e no contexto operacional.</p>
            </div>
          </div>
        `;
        return;
      }

      legalBasisBox.innerHTML = `
        <div class="legal-basis-stack">
          ${
            warnings.length
              ? `
                <div class="warning-list">
                  ${warnings.map((warning) => `<p>${escapeHtml(warning)}</p>`).join("")}
                </div>
              `
              : ""
          }
          <div class="legal-basis-list">
          ${
            retailDefaults.length
              ? `
                <article class="legal-chip legal-chip--retail-default">
                  <strong>Perfil padrao varejista</strong>
                  <span>Usado quando ainda nao existe regra legal especifica para o produto.</span>
                  <small>Serve como ponto de partida operacional, nao como regra fiscal publicada.</small>
                </article>
              `
              : ""
          }
          ${legalItems
            .map(
              (item) => `
                <article class="legal-chip">
                  <strong>${displayValue(item.tax_type, "-")}</strong>
                  <span>${displayValue(item.title, "-")}</span>
                  <small>${displayValue(item.reference_code, "-")} | ${displayValue(item.uf, "Brasil")}</small>
                </article>
              `,
            )
            .join("")}
          </div>
          ${
            retailDefaults.length && !legalItems.length
              ? `
                <div class="dashboard-empty dashboard-empty--attention">
                  <strong>Sem regra legal especifica ainda.</strong>
                  <p>A consulta ficou funcional pelo default de varejo. Cadastre uma regra fiscal para transformar essa sugestao em decisao oficial da plataforma.</p>
                </div>
              `
              : ""
          }
        </div>
      `;
    }

    function renderScore(payload) {
      if (!score || !scoreDetail) return;

      const confidence = Number(payload?.confidence_score || 0);
      const diagnostics = payload?.diagnostics || {};
      const ready = Number(diagnostics.ready || 0);
      const attention = Number(diagnostics.attention || 0);
      const missing = Number(diagnostics.missing || 0);
        score.textContent =
        confidence >= 0.9 ? "Alta confianca" :
        confidence >= 0.7 ? "Boa confianca" :
        confidence >= 0.5 ? "Confianca moderada" :
        "Confianca baixa";
      scoreDetail.textContent = `Match ${displayValue(payload?.match_type, "-")} com score ${confidence.toFixed(2)}. Diagnostico: ${ready} pronto(s), ${attention} em atencao, ${missing} pendente(s).`;
    }

    function diagnosticTone(status) {
      if (status === "ready") return "ready";
      if (status === "missing") return "missing";
      return "attention";
    }

    function diagnosticLabel(status) {
      if (status === "ready") return "Pronto";
      if (status === "missing") return "Pendente";
      return "Atencao";
    }

    function renderDiagnostics(payload) {
      const diagnostics = payload?.diagnostics || {};
      const items = Array.isArray(diagnostics.items) ? diagnostics.items : [];

      if (!items.length) {
        return "";
      }

      return `
        <section class="diagnostic-panel">
          <div class="diagnostic-panel__header">
            <div>
              <span>Leitura do motor</span>
              <strong>O que esta pronto e o que falta</strong>
            </div>
            <div class="diagnostic-counter">
              <span>${Number(diagnostics.ready || 0)} prontos</span>
              <span>${Number(diagnostics.attention || 0)} atencao</span>
              <span>${Number(diagnostics.missing || 0)} pendentes</span>
            </div>
          </div>
          <div class="diagnostic-grid">
            ${items
              .map((item) => {
                const tone = diagnosticTone(item.status);
                return `
                  <article class="diagnostic-card diagnostic-card--${tone}">
                    <div class="diagnostic-card__top">
                      <span>${displayValue(item.area, "-")}</span>
                      <strong>${diagnosticLabel(item.status)}</strong>
                    </div>
                    <h4>${displayValue(item.title, "-")}</h4>
                    <p>${displayValue(item.detail, "-")}</p>
                    <small>${displayValue(item.action, "-")}</small>
                  </article>
                `;
              })
              .join("")}
          </div>
        </section>
      `;
    }

    function decisionSummaryTone(severity) {
      if (severity === "success") return "success";
      if (severity === "danger") return "danger";
      if (severity === "info") return "info";
      return "warning";
    }

    function renderDecisionSummary(payload) {
      const summary = payload?.decision_summary || null;
      if (!summary?.status) {
        return "";
      }

      const tone = decisionSummaryTone(summary.severity);
      const nextActions = Array.isArray(summary.next_actions) ? summary.next_actions : [];
      const blockingReasons = Array.isArray(summary.blocking_reasons) ? summary.blocking_reasons : [];

      return `
        <section class="decision-summary decision-summary--${tone}">
          <div class="decision-summary__header">
            <div>
              <span>${displayValue(summary.status, "-")}</span>
              <strong>${displayValue(summary.title, "-")}</strong>
            </div>
            <div class="decision-summary__badges">
              <span>${summary.can_use_operationally ? "Uso operacional" : "Nao publicar ainda"}</span>
              <span>${summary.requires_manual_review ? "Revisao fiscal" : "Automatico"}</span>
            </div>
          </div>
          <p>${displayValue(summary.message, "-")}</p>
          ${
            blockingReasons.length
              ? `
                <div class="decision-summary__list">
                  <strong>Bloqueios</strong>
                  ${blockingReasons.map((item) => `<span>${escapeHtml(item)}</span>`).join("")}
                </div>
              `
              : ""
          }
          ${
            nextActions.length
              ? `
                <div class="decision-summary__list">
                  <strong>Proximas acoes</strong>
                  ${nextActions.slice(0, 4).map((item) => `<span>${escapeHtml(item)}</span>`).join("")}
                </div>
              `
              : ""
          }
          <div class="decision-summary__actions">
            <button id="create-rule-from-suggestion" class="decision-action" type="button">
              Criar regra com estes dados
            </button>
            <a class="decision-action decision-action--link" href="/admin/legal-rules">
              Abrir regras fiscais
            </a>
          </div>
        </section>
      `;
    }

    function inferRuleDraft(payload) {
      const suggestion = payload?.suggestion || {};
      const selectedOperation = payload?.selected_operation || {};
      const summary = payload?.decision_summary || {};
      const needsICMS = String(summary.blocking_reasons || "").toLowerCase().includes("icms");
      const needsPISCOFINS = String(summary.blocking_reasons || "").toLowerCase().includes("pis");
      const taxType = needsICMS ? "icms" : needsPISCOFINS ? "pis" : "ncm";
      const valueType = needsICMS || needsPISCOFINS ? "cst_rule" : "classification_rule";

      const content = {
        ncm: suggestion.ncm || "",
        ncm_ex: suggestion.ncm_ex || "",
        cest: suggestion.cest || "",
        cfop: suggestion.cfop || "",
        icms_cst: suggestion.icms_cst || "",
        csosn: suggestion.csosn || "",
        pis_cst: suggestion.pis_cst || "",
        cofins_cst: suggestion.cofins_cst || "",
        pis_rate: suggestion.pis_rate || "",
        cofins_rate: suggestion.cofins_rate || "",
        icms_rate: suggestion.icms_rate || "",
        fcp_rate: suggestion.fcp_rate || "",
        icms_st_rate: suggestion.icms_st_rate || "",
        cbenef: suggestion.cbenef || "",
        cclas_trib: suggestion.cclas_trib || "",
        ibs_rate: suggestion.ibs_rate || "",
        cbs_rate: suggestion.cbs_rate || "",
        selective_tax_code: suggestion.selective_tax_code || "",
        selective_tax_rate: suggestion.selective_tax_rate || "",
        ipi_cst: suggestion.ipi_cst || "",
        ipi_rate: suggestion.ipi_rate || "",
        ipi_cenq: suggestion.ipi_cenq || "",
      };

      return {
        tax_type: taxType,
        value_type: valueType,
        operation_code: selectedOperation.code || "",
        tax_regime: document.getElementById("tax-regime")?.value || "",
        target_crt: document.getElementById("target-crt")?.value || "",
        ncm_code: suggestion.ncm || "",
        cest: suggestion.cest || "",
        cclas_trib: suggestion.cclas_trib || "",
        cfop: suggestion.cfop || selectedOperation.cfop || "",
        pis_cst: suggestion.pis_cst || "",
        cofins_cst: suggestion.cofins_cst || "",
        icms_cst: suggestion.icms_cst || "",
        csosn: suggestion.csosn || "",
        cbenef: suggestion.cbenef || "",
        emitter_uf: document.getElementById("emitter-uf")?.value || "",
        recipient_uf: document.getElementById("recipient-uf")?.value || "",
        value_content: JSON.stringify(content, null, 2),
        priority: 120,
        confidence_base: String(payload?.confidence_score || "0.70"),
      };
    }

    function wireSuggestionActions(payload) {
      const button = document.getElementById("create-rule-from-suggestion");
      button?.addEventListener("click", () => {
        const draft = inferRuleDraft(payload);
        try {
          localStorage.setItem(LEGAL_RULE_DRAFT_KEY, JSON.stringify(draft));
        } catch {
          // Se o storage falhar, ainda abrimos a tela de regras.
        }
        window.location.href = "/admin/legal-rules";
      });
    }

    function renderResult(payload) {
      if (!result) return;

      const suggestion = payload?.suggestion || {};
      const selectedOperation = payload?.selected_operation || {};
      const cestReference = payload?.cest_reference || null;

      result.innerHTML = `
        <div class="result-shell">
          <div class="result-shell__header">
            <article class="result-card">
              <span>Operacao</span>
              <strong>${displayValue(selectedOperation.name)}</strong>
              <p>Codigo ${displayValue(selectedOperation.code)} | CFOP padrao ${displayValue(selectedOperation.cfop)}</p>
            </article>
            <article class="result-card result-card--soft">
              <span>Confianca</span>
              <strong>${Number(payload?.confidence_score || 0).toFixed(2)}</strong>
              <p>Match ${displayValue(payload?.match_type, "-")}</p>
            </article>
          </div>

          ${renderDecisionSummary(payload)}

          ${renderSimulationTaxTable(suggestion)}
          ${
            cestReference
              ? `
                <div class="result-note result-note--accent">
                  <strong>CEST ${displayValue(cestReference.code)}</strong>
                  <p>${displayValue(cestReference.description)} ${cestReference.segment ? `Segmento: ${displayValue(cestReference.segment)}.` : ""}</p>
                </div>
              `
              : ""
          }
          ${renderDiagnostics(payload)}
        </div>
      `;
      wireSuggestionActions(payload);
    }

    function getDefaultOperationCode() {
      return "sale_consumer_final";
    }

    async function applyOrganizationDefaults() {
      const organizationId = readStorage("organization_id");
      if (!organizationId) return;

      try {
        const response = await listOrganizations();
        const organizations = Array.isArray(response?.organizations) ? response.organizations : [];
        const active = organizations.find((item) => item.id === organizationId);
        if (!active) return;

        const homeUF = String(active.home_uf || "").trim().toUpperCase();
        const taxRegime = String(active.tax_regime || "").trim();
        const crt = String(active.crt || "").trim();

        const emitterInput = document.getElementById("emitter-uf");
        const recipientInput = document.getElementById("recipient-uf");
        const taxRegimeSelect = document.getElementById("tax-regime");
        const crtSelect = document.getElementById("target-crt");

        if (emitterInput && !emitterInput.value && homeUF) {
          emitterInput.value = homeUF;
        }
        if (recipientInput && !recipientInput.value && homeUF) {
          recipientInput.value = homeUF;
        }
        if (taxRegimeSelect && !taxRegimeSelect.value && taxRegime) {
          taxRegimeSelect.value = taxRegime;
        }
        if (crtSelect && !crtSelect.value && crt) {
          crtSelect.value = crt;
        }
        if (defaultsText) {
          const regimeLabel = taxRegime ? ` Regime: ${taxRegime}${crt ? `, CRT ${crt}` : ""}.` : "";
          defaultsText.textContent = homeUF
            ? `Padrao atual: venda a consumidor final em ${homeUF} para ${homeUF}.${regimeLabel} Voce pode ajustar isso abaixo se precisar.`
            : `Padrao atual: venda a consumidor final usando a UF da organizacao ativa.${regimeLabel}`;
        }
      } catch {
        if (defaultsText) {
          defaultsText.textContent = "Padrao atual: venda a consumidor final usando a UF da organizacao ativa.";
        }
      }
    }

    async function loadOperations() {
      try {
        const response = await listFiscalOperations();
        const operations = response.operations || [];
        if (!operationSelect) return;

        const defaultCode = getDefaultOperationCode();

        operationSelect.innerHTML = `
          <option value="">Venda a consumidor final (padrao)</option>
          ${operations
            .map(
              (item) => `
                <option value="${item.code}">
                  ${item.name} (${item.default_cfop || "-"})
                </option>
              `,
            )
            .join("")}
        `;

        const defaultOperation = operations.find((item) => item.code === defaultCode);
        if (!operationSelect.value && defaultOperation) {
          operationSelect.value = defaultCode;
        }
      } catch (error) {
        if (operationSelect) {
          operationSelect.innerHTML = `
            <option value="">Venda a consumidor final (padrao)</option>
            <option value="sale_consumer_final">Venda a consumidor final</option>
          `;
        }
        setMessage(`Falha ao carregar operacoes fiscais. A consulta usara o padrao de venda a consumidor final. Detalhe: ${String(error)}`, "error");
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const token = readStorage("token");
      const organizationId = readStorage("organization_id");

      if (!token || !organizationId) {
        setMessage("Faca login e selecione uma organizacao antes de consultar.", "error");
        return;
      }

      try {
        setMessage("Consultando motor tributario...", "success");

        const descriptionValue = document.getElementById("description")?.value?.trim() || "";
        const gtinValue = document.getElementById("gtin")?.value?.trim() || "";
        const ncmValue = document.getElementById("ncm-code")?.value?.trim() || "";
        const catalogMatch = !gtinValue && !ncmValue && descriptionValue
          ? await resolveCatalogMatch(descriptionValue)
          : null;

        if (!gtinValue && !ncmValue && descriptionValue && !catalogMatch) {
          renderNotFoundState(descriptionValue);
          setMessage("Nenhum produto foi encontrado no catalogo para essa descricao.", "error");
          return;
        }

        const payload = {
          gtin: gtinValue || catalogMatch?.gtin || "",
          description: descriptionValue || catalogMatch?.description || "",
          ncm_code: ncmValue || catalogMatch?.profile?.ncm || "",
          operation_code: document.getElementById("operation-code")?.value || getDefaultOperationCode(),
          tax_regime: document.getElementById("tax-regime")?.value || "",
          target_crt: document.getElementById("target-crt")?.value || "",
          emitter_uf: (document.getElementById("emitter-uf")?.value || "").trim().toUpperCase(),
          recipient_uf: (document.getElementById("recipient-uf")?.value || "").trim().toUpperCase(),
        };

        const response = await suggestTax(payload);
        if (!hasSuggestionPayload(response)) {
          renderNotFoundState(descriptionValue || gtinValue || ncmValue);
          setMessage("A consulta nao encontrou memoria fiscal suficiente para montar a tributacao.", "error");
          return;
        }
        renderScore(response);
        renderComparison(response);
        renderLegalBasis(response);
        renderResult(response);
        setMessage(
          catalogMatch
            ? "Consulta concluida com apoio do catalogo de produtos."
            : "Consulta tributaria concluida com sucesso.",
          "success",
        );
      } catch (error) {
        setMessage(`Falha na consulta: ${String(error)}`, "error");
      }
    });

    void loadOperations();
    void applyOrganizationDefaults();
  </script>

