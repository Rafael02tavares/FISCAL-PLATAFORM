---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import dashboardHomeScript from "../../scripts/dashboard-home.ts?url";
---

<DashboardLayout
  title="Dashboard fiscal"
  subtitle="Visao operacional conectada ao ambiente local"
>
  <div class="page-header">
    <h2>Painel executivo</h2>
    <p>
      Acompanhe o status da API, a organizacao ativa e as notas fiscais disponiveis no ambiente atual.
    </p>
  </div>

  <div class="grid grid--4">
    <section class="card card--padded stat-card">
      <span class="stat-card__label">Status da API</span>
      <strong class="stat-card__value" id="stat-api-status">Verificando...</strong>
      <span class="stat-card__trend" id="stat-api-trend">Consultando /health</span>
    </section>

    <section class="card card--padded stat-card">
      <span class="stat-card__label">Organizacoes disponiveis</span>
      <strong class="stat-card__value" id="stat-organizations">--</strong>
      <span class="stat-card__trend" id="stat-organizations-trend">Aguardando sessao</span>
    </section>

    <section class="card card--padded stat-card">
      <span class="stat-card__label">Organizacao ativa</span>
      <strong class="stat-card__value stat-card__value--compact" id="stat-active-organization">--</strong>
      <span class="stat-card__trend" id="stat-active-organization-trend">Defina uma organizacao</span>
    </section>

    <section class="card card--padded stat-card">
      <span class="stat-card__label">Notas importadas</span>
      <strong class="stat-card__value" id="stat-invoices">--</strong>
      <span class="stat-card__trend" id="stat-invoices-trend">Aguardando sessao</span>
    </section>
  </div>

  <div style="height: 18px;"></div>

  <div class="grid grid--2">
    <section class="card card--padded">
      <h3 class="section-title">Estado da sessao</h3>
      <div class="list" id="session-state">
        <div class="list-item">
          <div class="list-item__meta">
            <span class="list-item__title">Carregando contexto</span>
            <span class="list-item__subtitle">Verificando token e organizacao ativa no navegador</span>
          </div>
          <span class="badge badge--warning">Pendente</span>
        </div>
      </div>
    </section>

    <section class="card card--padded">
      <h3 class="section-title">Proximas acoes</h3>
      <div class="list" id="next-actions">
        <div class="list-item">
          <div class="list-item__meta">
            <span class="list-item__title">Carregando diagnostico</span>
            <span class="list-item__subtitle">O painel vai sugerir o proximo passo com base no que encontrar</span>
          </div>
          <span class="badge badge--warning">Analisando</span>
        </div>
      </div>
    </section>
  </div>

  <div style="height: 18px;"></div>

  <section class="card card--padded">
    <h3 class="section-title">Ultimas notas importadas</h3>
    <div id="invoices-panel">
      <p class="dashboard-muted">Carregando dados da API...</p>
    </div>
  </section>

  <script type="module" src={dashboardHomeScript}></script>

  <style>
    .stat-card__value--compact {
      font-size: 22px;
      line-height: 1.2;
      word-break: break-word;
    }

    .dashboard-muted {
      margin: 0;
      color: var(--text-muted);
    }

    .dashboard-empty {
      border: 1px dashed var(--border);
      border-radius: 12px;
      padding: 18px;
      background: var(--surface-soft);
    }

    .dashboard-empty strong {
      display: block;
      margin-bottom: 6px;
    }

    .dashboard-empty p {
      margin: 0;
      color: var(--text-muted);
    }

    .dashboard-empty--error {
      border-color: #fecaca;
      background: #fff7f7;
    }
  </style>
</DashboardLayout>
