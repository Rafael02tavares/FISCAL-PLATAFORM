---
import AppLayout from "../../../layouts/DashboardLayout.astro";
---

<AppLayout title="Admin · Regras legais">
  <section class="page-header legal-hero">
    <span class="section-kicker">Governanca fiscal</span>
    <h1>Regras legais</h1>
    <p>Cadastre e consulte regras normativas por tributo, operacao, regime, NCM e estado.</p>
  </section>

  <section class="panel">
    <h2>Nova regra legal</h2>

    <form id="legal-rule-form" class="form">
      <label>
        Fonte legal
        <select id="legal-source-id" required>
          <option value="">Carregando fontes...</option>
        </select>
      </label>

      <label>
        Tributo
        <select id="tax-type" required>
          <option value="">Selecione</option>
          <option value="cfop">CFOP</option>
          <option value="ncm">NCM</option>
          <option value="pis">PIS</option>
          <option value="cofins">COFINS</option>
          <option value="icms">ICMS</option>
          <option value="ipi">IPI</option>
          <option value="ibs">IBS</option>
          <option value="cbs">CBS</option>
          <option value="cbenef">CBENEF</option>
          <option value="cclas_trib">cClasTrib</option>
        </select>
      </label>

      <label>
        Tipo da regra
        <select id="value-type" required>
          <option value="">Selecione</option>
          <option value="cfop_rule">CFOP</option>
          <option value="classification_rule">Classificacao</option>
          <option value="cst_rule">CST</option>
          <option value="rate_rule">Aliquota</option>
          <option value="benefit_rule">Beneficio</option>
        </select>
      </label>

      <label>
        Operacao fiscal
        <select id="operation-code">
          <option value="">Carregando operacoes...</option>
        </select>
      </label>

      <label>
        Regime tributario
        <select id="tax-regime">
          <option value="">Todos</option>
          <option value="simples_nacional">Simples Nacional</option>
          <option value="lucro_presumido">Lucro Presumido</option>
          <option value="lucro_real">Lucro Real</option>
        </select>
      </label>

      <div class="form-grid form-grid--3">
        <label>
          NCM
          <input type="text" id="ncm-code" placeholder="22021000" />
        </label>

        <label>
          CEST
          <input type="text" id="cest" />
        </label>

        <label>
          cClasTrib
          <input type="text" id="cclas-trib" />
        </label>
      </div>

      <div class="form-grid form-grid--3">
        <label>
          CFOP
          <input type="text" id="cfop" />
        </label>

        <label>
          PIS CST
          <input type="text" id="pis-cst" />
        </label>

        <label>
          COFINS CST
          <input type="text" id="cofins-cst" />
        </label>
      </div>

      <div class="form-grid form-grid--3">
        <label>
          ICMS CST
          <input type="text" id="icms-cst" />
        </label>

        <label>
          CSOSN
          <input type="text" id="csosn" />
        </label>

        <label>
          CBENEF
          <input type="text" id="cbenef" />
        </label>
      </div>

      <div class="form-grid form-grid--2">
        <label>
          UF origem
          <input type="text" id="emitter-uf" maxlength="2" />
        </label>

        <label>
          UF destino
          <input type="text" id="recipient-uf" maxlength="2" />
        </label>
      </div>

      <label>
        Value Content (JSON)
        <textarea
          id="value-content"
          rows="6"
          placeholder='{"cfop":"5102"} ou {"pis_cst":"01","cofins_cst":"01"}'
          required
        ></textarea>
      </label>

      <div class="form-grid form-grid--4">
        <label>
          Prioridade
          <input type="number" id="priority" value="100" />
        </label>

        <label>
          Confianca base
          <input type="text" id="confidence-base" value="0.70" />
        </label>

        <label>
          Vigencia inicial
          <input type="date" id="effective-from" />
        </label>

        <label>
          Vigencia final
          <input type="date" id="effective-to" />
        </label>
      </div>

      <button type="submit">Salvar regra legal</button>
    </form>

    <pre id="legal-rule-result" class="result-box"></pre>
  </section>

  <section class="panel legal-rules-panel">
    <div class="legal-rules-heading">
      <div>
        <span class="section-kicker">Matriz normativa</span>
        <h2>Regras cadastradas por estado</h2>
        <p>Filtre por UF, tributo, regime e operacao para enxergar qual regra fortalece a sugestao fiscal em cada estado.</p>
      </div>
      <div class="rules-summary" id="rules-summary">
        <strong>--</strong>
        <span>regras carregadas</span>
      </div>
    </div>

    <div class="rules-filter-bar">
      <label>
        Estado
        <select id="filter-uf">
          <option value="">Todos os estados</option>
        </select>
      </label>

      <label>
        Tributo
        <select id="filter-tax-type">
          <option value="">Todos os tributos</option>
        </select>
      </label>

      <label>
        Regime
        <select id="filter-tax-regime">
          <option value="">Todos os regimes</option>
        </select>
      </label>

      <label>
        Operacao
        <select id="filter-operation">
          <option value="">Todas as operacoes</option>
        </select>
      </label>

      <label class="rules-search">
        Buscar
        <input id="filter-search" type="search" placeholder="NCM, CFOP, CST, CEST, fonte..." />
      </label>

      <button type="button" id="clear-filters" class="secondary-button">Limpar filtros</button>
    </div>

    <div class="rules-state-strip" id="rules-state-strip"></div>
    <div id="legal-rule-list">Carregando...</div>
  </section>

  <script type="module">
    const API_URL = "http://localhost:8081";

    const form = document.getElementById("legal-rule-form");
    const result = document.getElementById("legal-rule-result");
    const listWrapper = document.getElementById("legal-rule-list");
    const sourceSelect = document.getElementById("legal-source-id");
    const operationSelect = document.getElementById("operation-code");
    const rulesSummary = document.getElementById("rules-summary");
    const filterUF = document.getElementById("filter-uf");
    const filterTaxType = document.getElementById("filter-tax-type");
    const filterTaxRegime = document.getElementById("filter-tax-regime");
    const filterOperation = document.getElementById("filter-operation");
    const filterSearch = document.getElementById("filter-search");
    const clearFilters = document.getElementById("clear-filters");
    const stateStrip = document.getElementById("rules-state-strip");
    const LEGAL_RULE_DRAFT_KEY = "legal_rule_prefill";
    let allLegalRules = [];

    function setResult(message) {
      if (result) result.textContent = message;
    }

    async function apiFetch(path, options = {}) {
      const token = localStorage.getItem("token");
      const organizationId = localStorage.getItem("organization_id");

      const response = await fetch(`${API_URL}${path}`, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
          ...(organizationId ? { "X-Organization-ID": organizationId } : {}),
          ...(options.headers || {}),
        },
      });

      const contentType = response.headers.get("content-type") || "";
      const isJSON = contentType.includes("application/json");

      if (!response.ok) {
        const errorBody = isJSON ? await response.json() : await response.text();
        throw new Error(typeof errorBody === "string" ? errorBody : JSON.stringify(errorBody));
      }

      return isJSON ? response.json() : response.text();
    }

    async function listLegalSources() {
      return apiFetch("/legal-sources?limit=200", { method: "GET" });
    }

    async function listLegalRules() {
      return apiFetch("/legal-rules?limit=300", { method: "GET" });
    }

    async function listStateICMSRules() {
      return apiFetch("/admin/icms-state-rules?limit=500", { method: "GET" });
    }

    async function createLegalRule(payload) {
      return apiFetch("/legal-rules", {
        method: "POST",
        body: JSON.stringify(payload),
      });
    }

    async function listFiscalOperations() {
      return apiFetch("/fiscal-operations", { method: "GET" });
    }

    function escapeHTML(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function normalizeValue(value) {
      return String(value || "").trim();
    }

    function stateKey(item) {
      const emitterUF = normalizeValue(item.emitter_uf).toUpperCase();
      const recipientUF = normalizeValue(item.recipient_uf).toUpperCase();
      return recipientUF || emitterUF || "NACIONAL";
    }

    function formatStateFlow(item) {
      const emitterUF = normalizeValue(item.emitter_uf).toUpperCase();
      const recipientUF = normalizeValue(item.recipient_uf).toUpperCase();
      if (emitterUF && recipientUF) return `${emitterUF} -> ${recipientUF}`;
      return recipientUF || emitterUF || "Nacional";
    }

    function uniqueSorted(items, getter) {
      return [...new Set(items.map(getter).filter(Boolean))].sort((a, b) => a.localeCompare(b));
    }

    function populateFilter(select, values, emptyLabel) {
      if (!select) return;
      const current = select.value;
      select.innerHTML = `
        <option value="">${emptyLabel}</option>
        ${values.map((value) => `<option value="${escapeHTML(value)}">${escapeHTML(value)}</option>`).join("")}
      `;
      if (values.includes(current)) select.value = current;
    }

    function populateRuleFilters(items) {
      populateFilter(filterUF, uniqueSorted(items, stateKey), "Todos os estados");
      populateFilter(filterTaxType, uniqueSorted(items, (item) => normalizeValue(item.tax_type).toUpperCase()), "Todos os tributos");
      populateFilter(filterTaxRegime, uniqueSorted(items, (item) => normalizeValue(item.tax_regime)), "Todos os regimes");
      populateFilter(filterOperation, uniqueSorted(items, (item) => normalizeValue(item.operation_code)), "Todas as operacoes");
    }

    function mapStateICMSRule(item) {
      const source = item.source_reference || "Matriz estadual de ICMS";
      return {
        id: item.id,
        source_kind: "state_icms_rule",
        legal_source_id: source,
        tax_type: item.rule_kind === "ST" ? "ICMS-ST" : "ICMS",
        operation_code: item.operation_code,
        tax_regime: item.tax_regime,
        ncm_code: item.ncm_pattern,
        cest: item.cest,
        cclas_trib: "",
        cfop: item.cfop,
        pis_cst: "",
        cofins_cst: "",
        icms_cst: item.icms_cst,
        csosn: item.csosn,
        cbenef: item.cbenef,
        emitter_uf: item.uf,
        recipient_uf: item.uf,
        value_type: item.match_type === "exact" ? "motor_icms_exato" : item.ncm_pattern ? "motor_icms_prefixo" : "motor_icms_geral",
        value_content: JSON.stringify({
          rule_kind: item.rule_kind,
          match_type: item.match_type,
          icms_rate: item.icms_rate,
          fcp_rate: item.fcp_rate,
          icms_st_rate: item.icms_st_rate,
          icms_base_reduction: item.icms_base_reduction,
          source_reference: item.source_reference,
        }),
        priority: item.match_type === "exact" ? 20 : item.ncm_pattern ? 40 : 90,
        confidence_base: item.confidence_score,
        effective_from: item.valid_from,
        effective_to: item.valid_to,
        source_reference: source,
        source_url: item.source_url,
        notes: item.notes,
      };
    }

    function getFilteredRules() {
      const selectedUF = normalizeValue(filterUF?.value).toUpperCase();
      const selectedTaxType = normalizeValue(filterTaxType?.value).toUpperCase();
      const selectedRegime = normalizeValue(filterTaxRegime?.value).toLowerCase();
      const selectedOperation = normalizeValue(filterOperation?.value).toLowerCase();
      const search = normalizeValue(filterSearch?.value).toLowerCase();

      return allLegalRules.filter((item) => {
        const uf = stateKey(item).toUpperCase();
        const taxType = normalizeValue(item.tax_type).toUpperCase();
        const regime = normalizeValue(item.tax_regime).toLowerCase();
        const operation = normalizeValue(item.operation_code).toLowerCase();
        const haystack = [
          item.tax_type,
          item.value_type,
          item.operation_code,
          item.tax_regime,
          item.ncm_code,
          item.cest,
          item.cclas_trib,
          item.cfop,
          item.pis_cst,
          item.cofins_cst,
          item.icms_cst,
          item.csosn,
          item.cbenef,
          item.emitter_uf,
          item.recipient_uf,
          item.legal_source_id,
          item.source_reference,
          item.notes,
          item.value_content,
        ].map((value) => normalizeValue(value).toLowerCase()).join(" ");

        return (!selectedUF || uf === selectedUF)
          && (!selectedTaxType || taxType === selectedTaxType)
          && (!selectedRegime || regime === selectedRegime)
          && (!selectedOperation || operation === selectedOperation)
          && (!search || haystack.includes(search));
      });
    }

    function updateStateStrip(items) {
      if (!stateStrip) return;
      const counts = items.reduce((acc, item) => {
        const uf = stateKey(item);
        acc[uf] = (acc[uf] || 0) + 1;
        return acc;
      }, {});

      const entries = Object.entries(counts).sort(([a], [b]) => a.localeCompare(b));
      if (!entries.length) {
        stateStrip.innerHTML = "";
        return;
      }

      stateStrip.innerHTML = entries.map(([uf, count]) => `
        <button class="state-pill" type="button" data-uf="${escapeHTML(uf)}">
          <strong>${escapeHTML(uf)}</strong>
          <span>${count}</span>
        </button>
      `).join("");

      stateStrip.querySelectorAll("[data-uf]").forEach((button) => {
        button.addEventListener("click", () => {
          if (filterUF) {
            filterUF.value = button.dataset.uf || "";
            renderFilteredRules();
          }
        });
      });
    }

    function renderFilteredRules() {
      renderRules(getFilteredRules());
    }

    function renderRules(items) {
      if (!listWrapper) return;

      if (rulesSummary) {
        rulesSummary.innerHTML = `<strong>${items?.length || 0}</strong><span>de ${allLegalRules.length} regras</span>`;
      }
      updateStateStrip(items || []);

      if (!items?.length) {
        listWrapper.innerHTML = `
          <div class="empty-rules">
            <strong>Nenhuma regra encontrada para os filtros atuais.</strong>
            <span>Limpe os filtros ou cadastre uma regra estadual para fortalecer o motor.</span>
          </div>
        `;
        return;
      }

      const grouped = items.reduce((acc, item) => {
        const uf = stateKey(item);
        if (!acc[uf]) acc[uf] = [];
        acc[uf].push(item);
        return acc;
      }, {});

      listWrapper.innerHTML = Object.entries(grouped)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([uf, rules]) => `
          <article class="state-rule-group">
            <header class="state-rule-group__header">
              <div>
                <span class="state-label">Estado</span>
                <strong>${escapeHTML(uf)}</strong>
              </div>
              <span>${rules.length} regra(s)</span>
            </header>

            <div class="rules-table-wrap">
              <table class="rules-table">
                <thead>
                  <tr>
                    <th>Tributo</th>
                    <th>Operacao</th>
                    <th>Regime</th>
                    <th>UF</th>
                    <th>Classificacao</th>
                    <th>Resultado</th>
                    <th>Forca</th>
                  </tr>
                </thead>
                <tbody>
                  ${rules.map((item) => {
                    const output = [
                      item.cfop ? `CFOP ${item.cfop}` : "",
                      item.icms_cst ? `ICMS CST ${item.icms_cst}` : "",
                      item.csosn ? `CSOSN ${item.csosn}` : "",
                      item.pis_cst ? `PIS ${item.pis_cst}` : "",
                      item.cofins_cst ? `COFINS ${item.cofins_cst}` : "",
                      item.cbenef ? `cBenef ${item.cbenef}` : "",
                    ].filter(Boolean);
                    const classification = [
                      item.ncm_code ? `NCM ${item.ncm_code}` : "",
                      item.cest ? `CEST ${item.cest}` : "",
                      item.cclas_trib ? `cClasTrib ${item.cclas_trib}` : "",
                    ].filter(Boolean);
                    const confidenceWidth = Math.min(100, Math.max(0, Number(item.confidence_base || 0) * 100 || 0));
                    return `
                      <tr>
                        <td>
                          <span class="tax-chip tax-chip--${escapeHTML(normalizeValue(item.tax_type).toLowerCase())}">
                            ${escapeHTML(item.tax_type || "-")}
                          </span>
                          <small>${escapeHTML(item.value_type || "-")}</small>
                          ${item.source_kind === "state_icms_rule" ? `<small class="engine-source">Motor ICMS estadual</small>` : ""}
                        </td>
                        <td>${escapeHTML(item.operation_code || "Todas")}</td>
                        <td>${escapeHTML(item.tax_regime || "Todos")}</td>
                        <td><strong>${escapeHTML(formatStateFlow(item))}</strong></td>
                        <td>${classification.length ? escapeHTML(classification.join(" · ")) : "Geral"}</td>
                        <td>${output.length ? escapeHTML(output.join(" · ")) : escapeHTML(item.value_content || "{}")}</td>
                        <td>
                          <div class="confidence-meter"><span style="width:${confidenceWidth}%"></span></div>
                          <small>Prior. ${escapeHTML(item.priority || "-")} · Conf. ${escapeHTML(item.confidence_base || "-")}</small>
                        </td>
                      </tr>
                    `;
                  }).join("")}
                </tbody>
              </table>
            </div>
          </article>
        `).join("");
    }

    async function loadSources() {
      try {
        const data = await listLegalSources();
        const items = data.items || [];

        if (!sourceSelect) return;

        if (!items.length) {
          sourceSelect.innerHTML = `<option value="">Nenhuma fonte encontrada</option>`;
          return;
        }

        sourceSelect.innerHTML = `
          <option value="">Selecione</option>
          ${items.map((item) => `
            <option value="${escapeHTML(item.id)}">
              ${escapeHTML(item.title)} · ${escapeHTML(item.tax_type)}${item.uf ? ` · ${escapeHTML(item.uf)}` : ""}
            </option>
          `).join("")}
        `;
      } catch {
        if (sourceSelect) {
          sourceSelect.innerHTML = `<option value="">Erro ao carregar fontes</option>`;
        }
      }
    }

    async function loadOperations() {
      try {
        const data = await listFiscalOperations();
        const items = data.operations || [];

        if (!operationSelect) return;

        if (!items.length) {
          operationSelect.innerHTML = `<option value="">Nenhuma operacao encontrada</option>`;
          return;
        }

        operationSelect.innerHTML = `
          <option value="">Todas</option>
          ${items.map((item) => `
            <option value="${escapeHTML(item.code)}">${escapeHTML(item.name)}</option>
          `).join("")}
        `;
      } catch {
        if (operationSelect) {
          operationSelect.innerHTML = `<option value="">Erro ao carregar operacoes</option>`;
        }
      }
    }

    async function loadRules() {
      try {
        const [legalData, stateData] = await Promise.all([
          listLegalRules(),
          listStateICMSRules(),
        ]);
        allLegalRules = [
          ...(legalData.items || []),
          ...((stateData.items || []).map(mapStateICMSRule)),
        ];
        populateRuleFilters(allLegalRules);
        renderFilteredRules();
      } catch (error) {
        if (listWrapper) {
          listWrapper.textContent = `Erro ao carregar regras legais: ${String(error)}`;
        }
      }
    }

    function applyDraftPrefill() {
      let draft = null;
      try {
        const raw = localStorage.getItem(LEGAL_RULE_DRAFT_KEY);
        draft = raw ? JSON.parse(raw) : null;
        localStorage.removeItem(LEGAL_RULE_DRAFT_KEY);
      } catch {
        draft = null;
      }

      if (!draft || typeof draft !== "object") return;

      const map = {
        "tax-type": draft.tax_type,
        "value-type": draft.value_type,
        "operation-code": draft.operation_code,
        "tax-regime": draft.tax_regime,
        "ncm-code": draft.ncm_code,
        cest: draft.cest,
        "cclas-trib": draft.cclas_trib,
        cfop: draft.cfop,
        "pis-cst": draft.pis_cst,
        "cofins-cst": draft.cofins_cst,
        "icms-cst": draft.icms_cst,
        csosn: draft.csosn,
        cbenef: draft.cbenef,
        "emitter-uf": draft.emitter_uf,
        "recipient-uf": draft.recipient_uf,
        "value-content": draft.value_content,
        priority: draft.priority,
        "confidence-base": draft.confidence_base,
      };

      Object.entries(map).forEach(([id, value]) => {
        const element = document.getElementById(id);
        if (element) element.value = value || "";
      });

      setResult("Rascunho carregado a partir da ultima consulta tributaria. Revise a fonte legal antes de salvar.");
      form?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const valueContent = document.getElementById("value-content")?.value?.trim() || "{}";

      try {
        JSON.parse(valueContent);
      } catch {
        setResult("O campo Value Content precisa ser um JSON valido.");
        return;
      }

      const payload = {
        legal_source_id: document.getElementById("legal-source-id")?.value || "",
        tax_type: document.getElementById("tax-type")?.value || "",
        operation_code: document.getElementById("operation-code")?.value || "",
        tax_regime: document.getElementById("tax-regime")?.value || "",
        ncm_code: (document.getElementById("ncm-code")?.value || "").trim(),
        cest: (document.getElementById("cest")?.value || "").trim(),
        cclas_trib: (document.getElementById("cclas-trib")?.value || "").trim(),
        cfop: (document.getElementById("cfop")?.value || "").trim(),
        pis_cst: (document.getElementById("pis-cst")?.value || "").trim(),
        cofins_cst: (document.getElementById("cofins-cst")?.value || "").trim(),
        icms_cst: (document.getElementById("icms-cst")?.value || "").trim(),
        csosn: (document.getElementById("csosn")?.value || "").trim(),
        cbenef: (document.getElementById("cbenef")?.value || "").trim(),
        emitter_uf: (document.getElementById("emitter-uf")?.value || "").trim().toUpperCase(),
        recipient_uf: (document.getElementById("recipient-uf")?.value || "").trim().toUpperCase(),
        value_type: document.getElementById("value-type")?.value || "",
        value_content: valueContent,
        priority: Number(document.getElementById("priority")?.value || 100),
        confidence_base: (document.getElementById("confidence-base")?.value || "").trim(),
        effective_from: document.getElementById("effective-from")?.value || "",
        effective_to: document.getElementById("effective-to")?.value || "",
      };

      if (!payload.legal_source_id || !payload.tax_type || !payload.value_type) {
        setResult("Preencha os campos obrigatorios.");
        return;
      }

      try {
        setResult("Salvando regra legal...");
        await createLegalRule(payload);
        setResult("Regra legal cadastrada com sucesso.");
        form.reset();
        loadRules();
      } catch (error) {
        setResult(`Erro ao salvar regra legal: ${String(error)}`);
      }
    });

    [filterUF, filterTaxType, filterTaxRegime, filterOperation, filterSearch].forEach((element) => {
      element?.addEventListener("input", renderFilteredRules);
      element?.addEventListener("change", renderFilteredRules);
    });

    clearFilters?.addEventListener("click", () => {
      [filterUF, filterTaxType, filterTaxRegime, filterOperation, filterSearch].forEach((element) => {
        if (element) element.value = "";
      });
      renderFilteredRules();
    });

    Promise.all([loadSources(), loadOperations(), loadRules()]).then(applyDraftPrefill);
  </script>

  <style>
    .legal-hero {
      background:
        radial-gradient(circle at 90% 10%, rgba(14, 165, 233, 0.18), transparent 28rem),
