---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import adminReformaScript from "../../../scripts/admin-reforma.ts?url";
---

<DashboardLayout
  title="IBS, CBS e cClasTrib"
  subtitle="Gerencie classificacao e aliquotas da reforma tributaria por contexto fiscal"
>
  <div class="page-header">
    <h2>Governanca da reforma tributaria</h2>
    <p>
      Estruture as regras de `IBS`, `CBS` e `cClasTrib` com base legal, operacao, NCM, CFOP e
      filtros territoriais para manter sugestao e simulacao alinhadas.
    </p>
  </div>

  <section class="reform-hero">
    <div class="reform-hero__copy">
      <span class="reform-hero__eyebrow">Reforma tributaria</span>
      <h3>Painel tecnico para classificacao e contribuicoes do novo modelo</h3>
      <p>
        Use esta area para registrar regras de classificacao por `cClasTrib` e regras de aliquota
        para `IBS` e `CBS`, sempre vinculadas a uma fonte legal e ao contexto operacional.
      </p>
      <div class="reform-hero__legend">
        <span><i class="legend-dot legend-dot--amber"></i>cClasTrib</span>
        <span><i class="legend-dot legend-dot--teal"></i>IBS</span>
        <span><i class="legend-dot legend-dot--sky"></i>CBS</span>
      </div>
    </div>

    <div id="reform-stats" class="reform-stats">
      <div class="dashboard-note">Carregando indicadores da reforma...</div>
    </div>
  </section>

  <div class="reform-grid">
    <section class="card card--padded">
      <div class="section-heading section-heading--tight">
        <div>
          <span class="section-heading__eyebrow">Cadastro guiado</span>
          <h3>Nova regra de IBS, CBS ou cClasTrib</h3>
        </div>
        <a class="secondary-link" href="/admin/legal-rules">Abrir tela completa de regras</a>
      </div>

      <form id="reform-rule-form" class="reform-form">
        <label>
          Tributo / classificacao
          <select id="reform-tax-type" name="tax_type">
            <option value="ibs">IBS</option>
            <option value="cbs">CBS</option>
            <option value="cclas_trib">cClasTrib</option>
          </select>
        </label>

        <label>
          Fonte legal
          <select id="reform-legal-source" name="legal_source_id">
            <option value="">Carregando fontes legais...</option>
          </select>
        </label>

        <label>
          Operacao fiscal
          <input name="operation_code" type="text" placeholder="Ex.: VENDA_ESTADUAL" />
        </label>

        <label>
          Regime tributario
          <select name="tax_regime">
            <option value="">Todos</option>
            <option value="simples_nacional">Simples Nacional</option>
            <option value="lucro_presumido">Lucro Presumido</option>
            <option value="lucro_real">Lucro Real</option>
          </select>
        </label>

        <label>
          NCM
          <input name="ncm_code" type="text" placeholder="22021000" />
        </label>

        <label>
          CEST
          <input name="cest" type="text" placeholder="2804700" />
        </label>

        <label>
          CFOP
          <input name="cfop" type="text" placeholder="5102" />
        </label>

        <label>
          UF emitente
          <input name="emitter_uf" type="text" maxlength="2" placeholder="SP" />
        </label>

        <label>
          UF destinatario
          <input name="recipient_uf" type="text" maxlength="2" placeholder="RJ" />
        </label>

        <label data-tax-only="cclas_trib">
          cClasTrib de entrada
          <input name="input_cclas_trib" type="text" placeholder="123" />
        </label>

        <label data-tax-only="cclas_trib">
          cClasTrib sugerido
          <input name="suggested_cclas_trib" type="text" placeholder="456" />
        </label>

        <label data-tax-only="ibs">
          Aliquota IBS sugerida
          <input name="suggested_ibs_rate" type="text" placeholder="8.50" />
        </label>

        <label data-tax-only="cbs">
          Aliquota CBS sugerida
          <input name="suggested_cbs_rate" type="text" placeholder="9.30" />
        </label>

        <label>
          Prioridade
          <input name="priority" type="number" min="1" value="100" />
        </label>

        <label>
          Confianca base
          <input name="confidence_base" type="text" value="0.75" />
        </label>

        <label>
          Vigencia inicial
          <input name="effective_from" type="date" />
        </label>

        <label>
          Vigencia final
          <input name="effective_to" type="date" />
        </label>

        <div class="full-width reform-preview">
          <div class="reform-preview__head">
            <strong>JSON aplicado na sugestao</strong>
            <span>Gerado automaticamente a partir do tributo selecionado</span>
          </div>
          <pre id="reform-json-preview">{}</pre>
        </div>

        <div class="full-width form-actions">
          <button class="primary-button" type="submit">Salvar regra</button>
        </div>
      </form>

      <div id="reform-feedback" class="dashboard-note">
        Selecione o tributo da reforma, vincule a base legal e informe a classificacao ou aliquota sugerida.
      </div>
    </section>

    <section class="card card--padded">
      <div class="section-heading section-heading--tight">
        <div>
          <span class="section-heading__eyebrow">Mapa de regras</span>
          <h3>Regras cadastradas</h3>
        </div>
        <p>Exibe `rate_rule` de IBS/CBS e `classification_rule` de cClasTrib.</p>
      </div>

      <div id="reform-rules-list" class="dashboard-note">Carregando regras...</div>
    </section>
  </div>

  <script type="module" src={adminReformaScript}></script>

  <style>
    .reform-hero,
    .reform-grid {
      display: grid;
      gap: 18px;
      margin-bottom: 18px;
    }

    .reform-hero {
      grid-template-columns: 1.1fr 0.9fr;
      padding: 24px;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      background:
        radial-gradient(circle at top right, rgba(245, 158, 11, 0.14), transparent 28%),
        radial-gradient(circle at bottom left, rgba(14, 165, 233, 0.14), transparent 30%),
        linear-gradient(135deg, #fffef9, #f8fbff);
    }

    .reform-grid {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 0.95fr);
      align-items: start;
    }

    .reform-hero__eyebrow,
    .section-heading__eyebrow {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      background: #fef3c7;
      color: #92400e;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .reform-hero__copy h3 {
      margin: 10px 0;
      font-size: clamp(26px, 3vw, 38px);
    }

    .reform-hero__copy p,
    .section-heading p {
      margin: 0;
      color: #475569;
    }

    .reform-hero__legend {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 18px;
      color: #475569;
      font-size: 13px;
      font-weight: 600;
    }

    .reform-hero__legend span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      display: inline-block;
    }

    .legend-dot--amber { background: #f59e0b; }
    .legend-dot--teal { background: #0f766e; }
    .legend-dot--sky { background: #0ea5e9; }

    .reform-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      align-content: start;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: end;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .section-heading--tight {
      align-items: start;
    }

    .section-heading h3 {
      margin: 6px 0 0;
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
      background: white;
      font-weight: 700;
    }

    .reform-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .reform-form label {
      display: grid;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .reform-form input,
    .reform-form select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      font: inherit;
      background: white;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .reform-preview {
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: #f8fafc;
      padding: 16px;
    }

    .reform-preview__head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .reform-preview__head span {
      color: #64748b;
      font-size: 13px;
    }

    .reform-preview pre,
    .rule-card__json {
      margin: 0;
      white-space: pre-wrap;
      word-break: break-word;
      font-size: 12px;
      line-height: 1.55;
      color: #0f172a;
    }

    .form-actions {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .primary-button {
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, #b45309, #0ea5e9);
      color: white;
      font: inherit;
      font-weight: 700;
      padding: 12px 18px;
      cursor: pointer;
      box-shadow: 0 16px 30px rgba(180, 83, 9, 0.16);
    }

    .stat-card,
    .rule-card {
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .stat-card {
      padding: 14px;
      display: grid;
      gap: 6px;
    }

    .stat-card span {
      color: #64748b;
      font-size: 13px;
    }

    .stat-card strong {
      font-size: 24px;
      color: #0f172a;
      line-height: 1;
    }

    .stat-card--teal { background: #f0fdfa; }
    .stat-card--sky { background: #eff6ff; }
    .stat-card--amber { background: #fffbeb; }
    .stat-card--rose { background: #fff1f2; }

    .rule-list {
      display: grid;
      gap: 14px;
    }

    .rule-card {
      padding: 18px;
      display: grid;
      gap: 14px;
      background:
        radial-gradient(circle at top right, rgba(245, 158, 11, 0.08), transparent 24%),
        linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .rule-card--ibs {
      background:
        radial-gradient(circle at top right, rgba(15, 118, 110, 0.08), transparent 24%),
        linear-gradient(180deg, #ffffff, #f3fbf9);
    }

    .rule-card--cbs {
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 24%),
        linear-gradient(180deg, #ffffff, #f5fbff);
    }

    .rule-card__top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .rule-card__tag,
    .rule-card__badge {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
    }

    .rule-card__tag {
      background: #fff7ed;
      color: #9a3412;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .rule-card__badge {
      background: #ecfeff;
      color: #155e75;
    }

    .rule-card h3 {
      margin: 8px 0 4px;
      font-size: 20px;
    }

    .rule-card p {
      margin: 0;
      color: #475569;
    }

    .rule-card__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 14px;
    }

    .dashboard-empty {
      border: 1px dashed var(--border);
      border-radius: 16px;
      padding: 18px;
      background: var(--surface-soft);
    }

    .dashboard-empty--error {
      border-color: #fecaca;
      background: #fff7f7;
    }

    .feedback {
      margin-top: 16px;
      border-radius: 14px;
      padding: 14px 16px;
    }

    .feedback--success {
      background: #ecfdf5;
      color: #166534;
    }

    .feedback--error {
      background: #fff1f2;
      color: #b91c1c;
    }

    @media (max-width: 1080px) {
      .reform-hero,
      .reform-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .reform-form,
      .reform-stats,
      .rule-card__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</DashboardLayout>
