---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import adminCSTScript from "../../../scripts/admin-cst.ts?url";
---

<DashboardLayout
  title="CST de ICMS, PIS e COFINS"
  subtitle="Gerencie regras de CST por tributo, operacao, regime e contexto fiscal"
>
  <div class="page-header">
    <h2>Gestao de CST tributario</h2>
    <p>
      Centralize regras de CST para ICMS, PIS e COFINS com contexto operacional, filtros por UF e
      vinculacao a base legal.
    </p>
  </div>

  <section class="cst-hero">
    <div class="cst-hero__copy">
      <span class="cst-hero__eyebrow">Regras fiscais</span>
      <h3>Operacao assistida para CST de saida</h3>
      <p>
        Esta tela organiza o cadastro das regras que alimentam a sugestao fiscal. Voce informa o
        contexto da operacao e define o CST sugerido para cada tributo de forma objetiva.
      </p>
      <div class="cst-hero__legend">
        <span><i class="legend-dot legend-dot--sky"></i>ICMS e CSOSN</span>
        <span><i class="legend-dot legend-dot--rose"></i>PIS e COFINS</span>
        <span><i class="legend-dot legend-dot--teal"></i>Base legal vinculada</span>
      </div>
    </div>

    <div id="cst-stats" class="cst-stats">
      <div class="dashboard-note">Carregando panorama de CST...</div>
    </div>
  </section>

  <div class="cst-grid">
    <section class="card card--padded">
      <div class="section-heading section-heading--tight">
        <div>
          <span class="section-heading__eyebrow">Cadastro guiado</span>
          <h3>Nova regra CST</h3>
        </div>
        <a class="secondary-link" href="/admin/legal-rules">Abrir tela completa de regras</a>
      </div>

      <form id="cst-rule-form" class="cst-form">
        <label>
          Tributo
          <select id="cst-tax-type" name="tax_type">
            <option value="icms">ICMS</option>
            <option value="pis">PIS</option>
            <option value="cofins">COFINS</option>
          </select>
        </label>

        <label>
          Fonte legal
          <select id="cst-legal-source" name="legal_source_id">
            <option value="">Carregando fontes legais...</option>
          </select>
        </label>

        <label>
          Operacao fiscal
          <input name="operation_code" type="text" placeholder="Ex.: VENDA_INTERESTADUAL" />
        </label>

        <label>
          Regime tributario
          <select name="tax_regime">
            <option value="">Todos</option>
            <option value="simples_nacional">Simples Nacional</option>
            <option value="lucro_presumido">Lucro Presumido</option>
            <option value="lucro_real">Lucro Real</option>
          </select>
        </label>

        <label>
          NCM
          <input name="ncm_code" type="text" placeholder="22021000" />
        </label>

        <label>
          CEST
          <input name="cest" type="text" placeholder="2804700" />
        </label>

        <label>
          CFOP
          <input name="cfop" type="text" placeholder="5102" />
        </label>

        <label>
          cClasTrib
          <input name="cclas_trib" type="text" placeholder="123" />
        </label>

        <label>
          UF emitente
          <input name="emitter_uf" type="text" maxlength="2" placeholder="SP" />
        </label>

        <label>
          UF destinatario
          <input name="recipient_uf" type="text" maxlength="2" placeholder="RJ" />
        </label>

        <label data-tax-only="icms">
          CST de entrada
          <input name="input_icms_cst" type="text" placeholder="00" />
        </label>

        <label data-tax-only="icms">
          CSOSN de entrada
          <input name="input_csosn" type="text" placeholder="102" />
        </label>

        <label data-tax-only="pis">
          CST de entrada
          <input name="input_pis_cst" type="text" placeholder="50" />
        </label>

        <label data-tax-only="cofins">
          CST de entrada
          <input name="input_cofins_cst" type="text" placeholder="50" />
        </label>

        <label data-tax-only="icms">
          cBenef de entrada
          <input name="input_cbenef" type="text" placeholder="SP000001" />
        </label>

        <label data-tax-only="icms">
          CST sugerido
          <input name="suggested_icms_cst" type="text" placeholder="00" />
        </label>

        <label data-tax-only="icms">
          CSOSN sugerido
          <input name="suggested_csosn" type="text" placeholder="102" />
        </label>

        <label data-tax-only="icms">
          cBenef sugerido
          <input name="suggested_cbenef" type="text" placeholder="SP000001" />
        </label>

        <label data-tax-only="pis">
          CST sugerido
          <input name="suggested_pis_cst" type="text" placeholder="01" />
        </label>

        <label data-tax-only="cofins">
          CST sugerido
          <input name="suggested_cofins_cst" type="text" placeholder="01" />
        </label>

        <label>
          Prioridade
          <input name="priority" type="number" min="1" value="100" />
        </label>

        <label>
          Confianca base
          <input name="confidence_base" type="text" value="0.80" />
        </label>

        <label>
          Vigencia inicial
          <input name="effective_from" type="date" />
        </label>

        <label>
          Vigencia final
          <input name="effective_to" type="date" />
        </label>

        <div class="full-width cst-preview">
          <div class="cst-preview__head">
            <strong>JSON que sera aplicado na sugestao</strong>
            <span>Gerado automaticamente</span>
          </div>
          <pre id="cst-json-preview">{}</pre>
        </div>

        <div class="full-width form-actions">
          <button class="primary-button" type="submit">Salvar regra CST</button>
        </div>
      </form>

      <div id="cst-feedback" class="dashboard-note">
        Selecione o tributo, a base legal e o contexto da operacao para registrar a regra.
      </div>
    </section>

    <section class="card card--padded">
      <div class="section-heading section-heading--tight">
        <div>
          <span class="section-heading__eyebrow">Leitura operacional</span>
          <h3>Regras CST cadastradas</h3>
        </div>
        <p>Somente regras `cst_rule` de ICMS, PIS e COFINS aparecem aqui.</p>
      </div>

      <div id="cst-rules-list" class="dashboard-note">Carregando regras de CST...</div>
    </section>
  </div>

  <section class="card card--padded cst-reference-card">
    <div class="section-heading section-heading--tight">
      <div>
        <span class="section-heading__eyebrow">Referencia rapida</span>
        <h3>CST ICMS e CSOSN mais usados</h3>
      </div>
      <a class="secondary-link" href="https://cdmcontabilidade.com.br/tabela-cst-icms/" target="_blank" rel="noreferrer">
        Ver referencia externa
      </a>
    </div>

    <div class="cst-reference-grid">
      <article>
        <h4>CST ICMS - regime normal</h4>
        <p><strong>Origem</strong> 1o digito: 0 nacional, 1 importacao direta, 2 adquirida no mercado interno, 3-8 variacoes de origem/conteudo importado.</p>
        <p><strong>00</strong> Tributada integralmente</p>
        <p><strong>10</strong> Tributada e com cobranca de ICMS ST</p>
        <p><strong>20</strong> Com reducao de base de calculo</p>
        <p><strong>40/41</strong> Isenta ou nao tributada</p>
        <p><strong>51</strong> Diferimento</p>
        <p><strong>60</strong> ICMS cobrado anteriormente por ST</p>
        <p><strong>70</strong> Reducao de base com ICMS ST</p>
        <p><strong>90</strong> Outras</p>
      </article>

      <article>
        <h4>CSOSN - Simples Nacional</h4>
        <p><strong>CRT 1</strong> Empresas do Simples usam CSOSN, nao CST ICMS de regime normal.</p>
        <p><strong>101</strong> Tributada com permissao de credito</p>
        <p><strong>102</strong> Tributada sem permissao de credito</p>
        <p><strong>201/202/203</strong> Operacoes com ICMS ST</p>
        <p><strong>300</strong> Imune</p>
        <p><strong>400</strong> Nao tributada pelo Simples</p>
        <p><strong>500</strong> ICMS cobrado anteriormente por ST ou antecipacao</p>
        <p><strong>900</strong> Outros</p>
      </article>

      <article>
        <h4>CST PIS/COFINS - saidas</h4>
        <p><strong>01</strong> Operacao tributavel com aliquota basica</p>
        <p><strong>02</strong> Operacao tributavel com aliquota diferenciada</p>
        <p><strong>03</strong> Tributavel por unidade de medida</p>
        <p><strong>04</strong> Monofasica - revenda a aliquota zero</p>
        <p><strong>05</strong> Tributavel por substituicao tributaria</p>
        <p><strong>06/07/08/09</strong> Aliquota zero, isenta, sem incidencia ou suspensao</p>
        <p><strong>49</strong> Outras operacoes de saida</p>
      </article>

      <article>
        <h4>PIS/COFINS por regime</h4>
        <p><strong>Cumulativo</strong> Lucro Presumido geralmente usa 01 para saidas tributadas, com aliquotas usuais 0,65% e 3%.</p>
        <p><strong>Nao cumulativo</strong> Lucro Real usa 01/02/03 em vendas e 50-56 nas entradas com credito.</p>
        <p><strong>Simples</strong> Em geral usa CST 99 para PIS/COFINS como classificacao operacional.</p>
        <p><strong>Monofasico</strong> CST 04 indica revenda monofasica/alíquota zero conforme produto.</p>
      </article>

      <article>
        <h4>CST PIS/COFINS - entradas</h4>
        <p><strong>50-56</strong> Operacoes com direito a credito</p>
        <p><strong>60-67</strong> Credito presumido</p>
        <p><strong>70</strong> Aquisicao sem direito a credito</p>
        <p><strong>71-74</strong> Isencao, suspensao, aliquota zero ou sem incidencia</p>
        <p><strong>75</strong> Aquisicao por substituicao tributaria</p>
        <p><strong>98/99</strong> Outras operacoes de entrada ou outras operacoes</p>
      </article>

      <article>
        <h4>CST IPI - entradas</h4>
        <p><strong>00</strong> Entrada com recuperacao de credito</p>
        <p><strong>01</strong> Entrada tributavel com aliquota zero</p>
        <p><strong>02</strong> Entrada isenta</p>
        <p><strong>03</strong> Entrada nao tributada</p>
        <p><strong>04</strong> Entrada imune</p>
        <p><strong>05</strong> Entrada com suspensao</p>
        <p><strong>49</strong> Outras entradas</p>
      </article>

      <article>
        <h4>CST IPI - saidas</h4>
        <p><strong>50</strong> Saida tributada</p>
        <p><strong>51</strong> Saida tributavel com aliquota zero</p>
        <p><strong>52</strong> Saida isenta</p>
        <p><strong>53</strong> Saida nao tributada</p>
        <p><strong>54</strong> Saida imune</p>
        <p><strong>55</strong> Saida com suspensao</p>
        <p><strong>99</strong> Outras saidas</p>
      </article>
    </div>
  </section>

  <script type="module" src={adminCSTScript}></script>

  <style>
    .cst-hero,
    .cst-grid {
      display: grid;
      gap: 18px;
      margin-bottom: 18px;
    }

    .cst-hero {
      grid-template-columns: 1.05fr 0.95fr;
      padding: 24px;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.16), transparent 30%),
        radial-gradient(circle at bottom left, rgba(251, 113, 133, 0.15), transparent 30%),
        linear-gradient(135deg, #fffefc, #f8fbff);
    }

    .cst-grid {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 0.95fr);
      align-items: start;
    }

    .cst-hero__eyebrow,
    .section-heading__eyebrow {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      background: #ccfbf1;
      color: #115e59;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .cst-hero__copy h3 {
      margin: 10px 0;
      font-size: clamp(26px, 3vw, 38px);
    }

    .cst-hero__copy p,
    .section-heading p {
      margin: 0;
      color: #475569;
    }

    .cst-hero__legend {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 18px;
      color: #475569;
      font-size: 13px;
      font-weight: 600;
    }

    .cst-hero__legend span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      display: inline-block;
    }

    .legend-dot--sky { background: #0ea5e9; }
    .legend-dot--rose { background: #fb7185; }
    .legend-dot--teal { background: #0f766e; }

    .cst-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      align-content: start;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: end;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .section-heading--tight {
      align-items: start;
    }

    .section-heading h3 {
      margin: 6px 0 0;
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
      background: white;
      font-weight: 700;
    }

    .cst-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .cst-reference-card {
      margin-top: 18px;
    }

    .cst-reference-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .cst-reference-grid article {
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      padding: 16px;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .cst-reference-grid h4 {
      margin: 0 0 12px;
      color: #0f172a;
    }

    .cst-reference-grid p {
      display: flex;
      gap: 10px;
      margin: 0;
      padding: 9px 0;
      border-bottom: 1px dashed #dbe4ee;
      color: #475569;
    }

    .cst-reference-grid p:last-child {
      border-bottom: none;
    }

    .cst-reference-grid strong {
      min-width: 58px;
      color: #0f766e;
    }

    .cst-form label {
      display: grid;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .cst-form input,
    .cst-form select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      font: inherit;
      background: white;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .cst-preview {
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: #f8fafc;
      padding: 16px;
    }

    .cst-preview__head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .cst-preview__head span {
      color: #64748b;
      font-size: 13px;
    }

    .cst-preview pre,
    .rule-card__json {
      margin: 0;
      white-space: pre-wrap;
      word-break: break-word;
      font-size: 12px;
      line-height: 1.55;
      color: #0f172a;
    }

    .form-actions {
      display: flex;
      justify-content: flex-start;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .primary-button {
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, #0f766e, #0ea5e9);
      color: white;
      font: inherit;
      font-weight: 700;
      padding: 12px 18px;
      cursor: pointer;
      box-shadow: 0 16px 30px rgba(15, 118, 110, 0.18);
    }

    .stat-card,
    .rule-card {
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .stat-card {
      padding: 14px;
      display: grid;
      gap: 6px;
    }

    .stat-card span {
      color: #64748b;
      font-size: 13px;
    }

    .stat-card strong {
      font-size: 24px;
      color: #0f172a;
      line-height: 1;
    }

    .stat-card--sky { background: #eff6ff; }
    .stat-card--rose { background: #fff1f2; }
    .stat-card--teal { background: #f0fdfa; }

    .rule-list {
      display: grid;
      gap: 14px;
    }

    .rule-card {
      padding: 18px;
      display: grid;
      gap: 14px;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 26%),
        linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .rule-card--pis,
    .rule-card--cofins {
      background:
        radial-gradient(circle at top right, rgba(251, 113, 133, 0.08), transparent 26%),
        linear-gradient(180deg, #ffffff, #fff8fb);
    }

    .rule-card__top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .rule-card__tag,
    .rule-card__badge {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
    }

    .rule-card__tag {
      background: #e0f2fe;
      color: #075985;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .rule-card__badge {
      background: #ecfeff;
      color: #155e75;
    }

    .rule-card h3 {
      margin: 8px 0 4px;
      font-size: 20px;
    }

    .rule-card p {
      margin: 0;
      color: #475569;
    }

    .rule-card__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 14px;
    }

    .dashboard-empty {
      border: 1px dashed var(--border);
      border-radius: 16px;
      padding: 18px;
      background: var(--surface-soft);
    }

    .dashboard-empty--error {
      border-color: #fecaca;
      background: #fff7f7;
    }

    .feedback {
      margin-top: 16px;
      border-radius: 14px;
      padding: 14px 16px;
    }

    .feedback--success {
      background: #ecfdf5;
      color: #166534;
    }

    .feedback--error {
      background: #fff1f2;
      color: #b91c1c;
    }

    @media (max-width: 1080px) {
      .cst-hero,
      .cst-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .cst-form,
      .cst-stats,
      .cst-reference-grid,
      .rule-card__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</DashboardLayout>
