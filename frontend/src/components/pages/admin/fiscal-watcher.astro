---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import watcherScript from "../../../scripts/fiscal-watcher.ts?url";
---

<DashboardLayout
  title="Fiscal Watcher"
  subtitle="Monitoramento de fontes oficiais com fila de revisao para o time fiscal"
>
  <section class="watcher-hero">
    <div class="watcher-hero__copy">
      <span class="watcher-hero__eyebrow">Fontes oficiais</span>
      <h2>Fiscal Watcher</h2>
      <p>Monitore Planalto, CONFAZ e Portal NF-e e transforme cada verificacao em evento revisavel pela equipe.</p>
    </div>

    <div class="watcher-hero__actions">
      <button id="watcher-run-all" type="button" class="watcher-primary-button">Verificar tudo</button>
      <div id="watcher-feedback" class="watcher-feedback">Pronto</div>
    </div>
  </section>

  <section class="watcher-grid">
    <article class="card card--padded">
      <h3 class="section-title">Fontes monitoradas</h3>
      <div id="watcher-sources" class="dashboard-note">Carregando fontes...</div>
    </article>

    <article class="card card--padded">
      <h3 class="section-title">Fila de eventos</h3>
      <div id="watcher-events" class="dashboard-note">Carregando eventos...</div>
    </article>
  </section>

  <script type="module" src={watcherScript}></script>

  <style>
    .watcher-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
      gap: 18px;
      margin-bottom: 20px;
    }

    .watcher-hero__copy,
    .watcher-hero__actions {
      display: grid;
      gap: 10px;
    }

    .watcher-hero__eyebrow {
      display: inline-flex;
      width: fit-content;
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(14, 165, 233, 0.12);
      color: #0c4a6e;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .watcher-hero h2 {
      margin: 0;
      color: #0f172a;
    }

    .watcher-hero p {
      margin: 0;
      color: #475569;
      line-height: 1.7;
    }

    .watcher-primary-button,
    .watcher-button,
    .watcher-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 16px;
      border-radius: 14px;
      font-weight: 700;
    }

    .watcher-primary-button,
    .watcher-button {
      border: none;
      cursor: pointer;
      color: #ffffff;
      background: linear-gradient(135deg, #0f766e, #2563eb);
    }

    .watcher-link {
      border: 1px solid var(--border);
      background: #ffffff;
      color: var(--text);
      text-decoration: none;
    }

    .watcher-feedback {
      border-radius: 14px;
      padding: 14px 16px;
      background: #f8fafc;
      color: #475569;
      border: 1px solid #dbe4ee;
    }

    .watcher-feedback--success {
      background: #ecfdf5;
      color: #166534;
    }

    .watcher-feedback--error {
      background: #fff1f2;
      color: #b91c1c;
    }

    .watcher-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px;
    }

    .watcher-source-card,
    .watcher-event-card {
      display: grid;
      gap: 12px;
      padding: 16px;
      border-radius: 16px;
      border: 1px solid #dbe4ee;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .watcher-source-card__top,
    .watcher-event-card__top,
    .watcher-source-card__actions {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
    }

    .watcher-source-card__top p,
    .watcher-event-card__top p,
    .watcher-event-card p {
      margin: 4px 0 0;
      color: #475569;
    }

    .watcher-source-card__meta,
    .watcher-event-card__meta,
    .watcher-event-list {
      display: grid;
      gap: 10px;
    }

    .watcher-source-card__type,
    .watcher-badge {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    .watcher-source-card__type {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .watcher-badge--high {
      background: #fee2e2;
      color: #b91c1c;
    }

    .watcher-badge--medium {
      background: #fef3c7;
      color: #92400e;
    }

    .watcher-badge--low {
      background: #dcfce7;
      color: #166534;
    }

    @media (max-width: 980px) {
      .watcher-hero,
      .watcher-grid {
        grid-template-columns: 1fr;
      }

      .watcher-source-card__actions {
        flex-direction: column;
      }
    }
  </style>
</DashboardLayout>
