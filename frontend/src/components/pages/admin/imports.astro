---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import adminImportsScript from "../../../scripts/admin-imports.ts?url";
---

<DashboardLayout
  title="Importacoes administrativas"
  subtitle="Carregue catalogos estruturados e acompanhe os lotes processados"
>
  <div class="page-header">
    <h2>Importacoes administrativas</h2>
    <p>Use esta area para enviar catalogos oficiais em CSV, XLSX ou conteudo copiado da fonte legal.</p>
  </div>

  <div class="admin-import-grid">
    <section class="card card--padded">
      <div class="catalog-stack">

        <!-- NCM -->
        <article class="catalog-panel">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar catalogo NCM</h3>
              <p>Ideal para manter classificacao, EX e descricoes oficiais do catalogo NCM.</p>
            </div>
            <span class="catalog-tag">ncm_catalog</span>
          </div>

          <form id="ncm-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="source-name" type="text" value="NCM CSV" class="form-input" />
            </label>

            <label>
              Versao
              <input id="version-label" type="text" placeholder="Ex.: tabela 2026-01" class="form-input" />
            </label>

            <label class="full-width">
              Arquivo de importacao
              <input
                id="ncm-file"
                type="file"
                accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="form-input-file"
              />
            </label>

            <div class="full-width import-actions">
              <button id="submit-import" class="primary-button" type="submit">Importar NCM</button>
              <a class="secondary-link" href="/ncm">Abrir consulta de NCM</a>
            </div>
          </form>

          <div id="import-feedback" class="dashboard-note">
            Envie um CSV ou XLSX de NCM para popular a tabela ncm_catalog.
          </div>
        </article>

        <!-- CFOP -->
        <article class="catalog-panel catalog-panel--accent">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar catalogo CFOP</h3>
              <p>Aceita a planilha oficial do CONFAZ em XLSX e tambem arquivos CSV estruturados.</p>
            </div>
            <span class="catalog-tag catalog-tag--gold">cfop_catalog</span>
          </div>

          <form id="cfop-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="cfop-source-name" type="text" value="CFOP XLSX" class="form-input" />
            </label>

            <label>
              Versao
              <input id="cfop-version-label" type="text" placeholder="Ex.: tabela 2026-04" class="form-input" />
            </label>

            <label class="full-width">
              Arquivo de importacao
              <input
                id="cfop-file"
                type="file"
                accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="form-input-file"
              />
            </label>

            <div class="full-width import-actions">
              <button id="submit-cfop-import" class="primary-button primary-button--gold" type="submit">Importar CFOP</button>
              <a class="secondary-link" href="/cfop">Abrir consulta de CFOP</a>
            </div>
          </form>

          <div id="cfop-import-feedback" class="dashboard-note">
            Envie um CSV ou XLSX de CFOP para popular a tabela cfop_catalog.
          </div>
        </article>

        <!-- CEST -->
        <article class="catalog-panel catalog-panel--cest">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar catalogo CEST</h3>
              <p>Use a tabela CEST para conectar NCM, segmento e regras de ICMS ST.</p>
            </div>
            <span class="catalog-tag catalog-tag--blue">cest_catalog</span>
          </div>

          <form id="cest-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="cest-source-name" type="text" value="CEST XLSX" class="form-input" />
            </label>

            <label>
              Versao
              <input id="cest-version-label" type="text" placeholder="Ex.: CONFAZ 2026" class="form-input" />
            </label>

            <label class="full-width">
              Arquivo de importacao
              <input
                id="cest-file"
                type="file"
                accept=".csv,.xlsx,.txt,.html,text/csv,text/plain,text/html,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="form-input-file"
              />
            </label>

            <label class="full-width">
              Ou cole aqui a tabela oficial do CONFAZ
              <textarea
                id="cest-raw-content"
                rows="8"
                placeholder="Cole linhas com ITEM | CEST | NCM/SH | DESCRICAO copiadas do Convênio ICMS 142/18"
                class="form-textarea"
              ></textarea>
            </label>

            <div class="full-width import-actions">
              <button id="submit-cest-import" class="primary-button primary-button--blue" type="submit">Importar CEST</button>
              <a class="secondary-link" href="/cest">Abrir consulta de CEST</a>
            </div>
          </form>

          <div id="cest-import-feedback" class="dashboard-note">
            Envie CSV/XLSX ou cole a tabela oficial do CONFAZ para popular a tabela cest_catalog.
          </div>
        </article>

        <!-- cBenef -->
        <article class="catalog-panel catalog-panel--cbenef">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar catalogo cBenef</h3>
              <p>Carregue tabelas estaduais de beneficios fiscais por CST, como SP e GO.</p>
            </div>
            <span class="catalog-tag catalog-tag--teal">cbenef_catalog</span>
          </div>

          <form id="cbenef-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="cbenef-source-name" type="text" value="cBenef GO" class="form-input" />
            </label>

            <label>
              Versao
              <input id="cbenef-version-label" type="text" placeholder="Ex.: IN 1518/22 atualizada" class="form-input" />
            </label>

            <label>
              UF padrao
              <input id="cbenef-uf" type="text" value="GO" maxlength="2" placeholder="GO" class="form-input" />
            </label>

            <label>
              Arquivo de importacao
              <input
                id="cbenef-file"
                type="file"
                accept=".csv,.xlsx,.txt,.html,text/csv,text/plain,text/html,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="form-input-file"
              />
            </label>

            <label class="full-width">
              Ou cole aqui a tabela estadual de cBenef
              <textarea
                id="cbenef-raw-content"
                rows="8"
                placeholder="Cole linhas como CODIGO | CST 00 | CST 10 | ... | DISPOSITIVO LEGAL | DESCRICAO | OBSERVACAO"
                class="form-textarea"
              ></textarea>
            </label>

            <div class="full-width import-actions">
              <button id="submit-cbenef-import" class="primary-button primary-button--teal" type="submit">Importar cBenef</button>
              <a class="secondary-link" href="/admin/cbenef">Abrir regras de cBenef</a>
            </div>
          </form>

          <div id="cbenef-import-feedback" class="dashboard-note">
            Use XLSX/CSV ou cole a tabela de beneficios fiscais da UF para popular a tabela cbenef_catalog.
          </div>
        </article>

        <!-- ST estadual CONFAZ -->
        <article class="catalog-panel catalog-panel--st">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar ST estadual CONFAZ</h3>
              <p>Carregue planilhas estaduais do Portal Nacional da ST e grave regras por UF e CEST no motor.</p>
            </div>
            <span class="catalog-tag catalog-tag--amber">state_icms_rules</span>
          </div>

          <form id="state-st-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="state-st-source-name" type="text" value="CONFAZ ST GO" class="form-input" />
            </label>

            <label>
              Versao
              <input id="state-st-version-label" type="text" value="Versao 001 - vigencia 10/07/2023" class="form-input" />
            </label>

            <label>
              UF
              <input id="state-st-uf" type="text" value="GO" maxlength="2" placeholder="GO" class="form-input" />
            </label>

            <label>
              Arquivo XLSX
              <input
                id="state-st-file"
                type="file"
                accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="form-input-file"
              />
            </label>

            <label class="full-width">
              URL da fonte oficial
              <input
                id="state-st-source-url"
                type="url"
                value="https://www.confaz.fazenda.gov.br/legislacao/portal-nacional-da-substituicao-tributaria/goias/planilha_eletronica_st_versao_0001_go_vigencia_a_partir_de_10-07-23.xlsx"
                class="form-input"
              />
            </label>

            <div class="full-width import-actions">
              <button id="submit-state-st-import" class="primary-button primary-button--amber" type="submit">Importar ST estadual</button>
              <a class="secondary-link" href="/admin/legal-rules">Ver regras por estado</a>
            </div>
          </form>

          <div id="state-st-import-feedback" class="dashboard-note">
            Use o XLSX original do CONFAZ. Ele sera lido por abas e salvo como regra estadual de ICMS-ST.
          </div>
        </article>

      </div>
    </section>

    <section class="card card--padded">
      <h3 class="section-title">Ultimos lotes</h3>
      <div id="import-batches" class="dashboard-note">Carregando historico...</div>
    </section>
  </div>

  <script type="module" src={adminImportsScript}></script>

  <style>
    .admin-import-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 18px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .catalog-stack {
      display: grid;
      gap: 18px;
    }

    .catalog-panel {
      display: grid;
      gap: 14px;
      padding: 18px;
      border-radius: 18px;
      border: 1px solid #d9e4f0;
      background: linear-gradient(180deg, #ffffff, #f8fbff);
    }

    .catalog-panel--accent {
      border-color: #f1d7a3;
      background: linear-gradient(180deg, #fffdf7, #fff7e8);
    }

    .catalog-panel--cest {
      border-color: #bfdbfe;
      background: linear-gradient(180deg, #ffffff, #eff6ff);
    }

    .catalog-panel--cbenef {
      border-color: #99f6e4;
      background: linear-gradient(180deg, #ffffff, #ecfeff);
    }

    .catalog-panel--st {
      border-color: #fcd34d;
      background: linear-gradient(180deg, #fffdf7, #fffbeb);
    }

    .catalog-panel__header {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
    }

    .catalog-panel__header p {
      margin: 6px 0 0;
      color: #475569;
    }

    .catalog-tag {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      background: #dcfce7;
      color: #166534;
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    .catalog-tag--gold  { background: #fef3c7; color: #92400e; }
    .catalog-tag--blue  { background: #dbeafe; color: #1d4ed8; }
    .catalog-tag--teal  { background: #ccfbf1; color: #0f766e; }
    .catalog-tag--amber { background: #fef3c7; color: #92400e; }

    .form-grid label {
      display: grid;
      gap: 8px;
      font-weight: 600;
      font-size: 14px;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .import-actions {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    @media (max-width: 900px) {
      .admin-import-grid,
      .form-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</DashboardLayout>
