---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import adminImportsScript from "../../../scripts/admin-imports.ts?url";
---

<DashboardLayout
  title="Importacoes administrativas"
  subtitle="Carregue catalogos estruturados e acompanhe os lotes processados"
>
  <div class="page-header">
    <h2>Importacoes administrativas</h2>
    <p>Use esta area para enviar os catalogos oficiais de NCM e CFOP em CSV ou XLSX e manter a plataforma atualizada.</p>
  </div>

  <div class="admin-import-grid">
    <section class="card card--padded">
      <div class="catalog-stack">
        <article class="catalog-panel">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar catalogo NCM</h3>
              <p>Ideal para manter classificacao, EX e descricoes oficiais do catalogo NCM.</p>
            </div>
            <span class="catalog-tag">ncm_catalog</span>
          </div>

          <form id="ncm-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="source-name" type="text" value="NCM CSV" />
            </label>

            <label>
              Versao
              <input id="version-label" type="text" placeholder="Ex.: tabela 2026-01" />
            </label>

            <label class="full-width">
              Arquivo de importacao
              <input id="ncm-file" type="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </label>

            <div class="full-width import-actions">
              <button id="submit-import" class="primary-button" type="submit">Importar NCM</button>
              <a class="secondary-link" href="/ncm">Abrir consulta de NCM</a>
            </div>
          </form>

          <div id="import-feedback" class="dashboard-note">
            Envie um CSV ou XLSX de NCM para popular a tabela ncm_catalog.
          </div>
        </article>

        <article class="catalog-panel catalog-panel--accent">
          <div class="catalog-panel__header">
            <div>
              <h3 class="section-title">Importar catalogo CFOP</h3>
              <p>Aceita a planilha oficial do CONFAZ em XLSX e tambem arquivos CSV estruturados.</p>
            </div>
            <span class="catalog-tag catalog-tag--gold">cfop_catalog</span>
          </div>

          <form id="cfop-import-form" class="form-grid">
            <label>
              Nome da fonte
              <input id="cfop-source-name" type="text" value="CFOP XLSX" />
            </label>

            <label>
              Versao
              <input id="cfop-version-label" type="text" placeholder="Ex.: tabela 2026-04" />
            </label>

            <label class="full-width">
              Arquivo de importacao
              <input id="cfop-file" type="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </label>

            <div class="full-width import-actions">
              <button id="submit-cfop-import" class="primary-button primary-button--gold" type="submit">Importar CFOP</button>
              <a class="secondary-link" href="/cfop">Abrir consulta de CFOP</a>
            </div>
          </form>

          <div id="cfop-import-feedback" class="dashboard-note">
            Envie um CSV ou XLSX de CFOP para popular a tabela cfop_catalog.
          </div>
        </article>
      </div>
    </section>

    <section class="card card--padded">
      <h3 class="section-title">Ultimos lotes</h3>
      <div id="import-batches" class="dashboard-note">Carregando historico...</div>
    </section>
  </div>

  <script type="module" src={adminImportsScript}></script>

  <style>
    .admin-import-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 18px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .catalog-stack {
      display: grid;
      gap: 18px;
    }

    .catalog-panel {
      display: grid;
      gap: 14px;
      padding: 18px;
      border-radius: 18px;
      border: 1px solid #d9e4f0;
      background: linear-gradient(180deg, #ffffff, #f8fbff);
    }

    .catalog-panel--accent {
      border-color: #f1d7a3;
      background: linear-gradient(180deg, #fffdf7, #fff7e8);
    }

    .catalog-panel__header {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
    }

    .catalog-panel__header p {
      margin: 6px 0 0;
      color: #475569;
    }

    .catalog-tag {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      background: #dcfce7;
      color: #166534;
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    .catalog-tag--gold {
      background: #fef3c7;
      color: #92400e;
    }

    .form-grid label {
      display: grid;
      gap: 8px;
      font-weight: 600;
      font-size: 14px;
    }

    .form-grid input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      font: inherit;
      background: white;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .import-actions {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .primary-button {
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #0f766e, #2563eb);
      color: white;
      font: inherit;
      font-weight: 700;
      padding: 12px 16px;
      cursor: pointer;
    }

    .primary-button--gold {
      background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
      background: white;
      font-weight: 700;
    }

    .batch-list {
      display: grid;
      gap: 12px;
    }

    .batch-card {
      display: grid;
      gap: 8px;
      padding: 16px;
      border-radius: 16px;
      border: 1px solid #dbe4ee;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .batch-card__top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: baseline;
    }

    .batch-card__meta {
      display: grid;
      gap: 6px;
      color: #475569;
      font-size: 14px;
    }

    .batch-badge {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      background: #dcfce7;
      color: #166534;
      font-size: 12px;
      font-weight: 800;
    }

    .feedback {
      margin-top: 16px;
      border-radius: 14px;
      padding: 14px 16px;
    }

    .feedback--success {
      background: #ecfdf5;
      color: #166534;
    }

    .feedback--error {
      background: #fff1f2;
      color: #b91c1c;
    }

    @media (max-width: 900px) {
      .admin-import-grid,
      .form-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</DashboardLayout>
