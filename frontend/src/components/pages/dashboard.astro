---
import AppLayout from "../../layouts/DashboardLayout.astro";
---

<AppLayout
  title="Dashboard"
  subtitle="Portal de consulta tributaria com atalhos para consultar impostos, importar notas e navegar pela base fiscal"
>
  <section class="dashboard-hero card card--hero">
    <div class="dashboard-hero__copy">
      <span class="dashboard-kicker">Central fiscal</span>
      <h2>Consulte, valide e alimente sua base tributaria</h2>
      <p>
        A dashboard agora mostra o que importa para operar: contexto da empresa, volume de notas,
        produtos consultaveis e atalhos para gerar sugestoes fiscais com seguranca.
      </p>

      <div class="dashboard-hero__actions">
        <a class="button-link" href="/simulacao">Consultar tributos</a>
        <a class="button-soft" href="/importacoes">Importar XML</a>
        <a class="button-soft" href="/produtos">Consultar catalogo</a>
        <a class="button-soft dashboard-admin-link" href="/admin">Administracao</a>
      </div>
    </div>

      <div class="dashboard-radar" aria-hidden="true">
      <div class="dashboard-radar__badge">Fluxo principal</div>
      <svg viewBox="0 0 360 250" class="dashboard-radar__svg" role="img">
        <defs>
          <linearGradient id="dashGlow" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0f766e"></stop>
            <stop offset="100%" stop-color="#0ea5e9"></stop>
          </linearGradient>
          <linearGradient id="dashWarm" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f59e0b"></stop>
            <stop offset="100%" stop-color="#fb7185"></stop>
          </linearGradient>
        </defs>
        <rect x="20" y="20" width="320" height="210" rx="30" fill="#ffffff" stroke="#d9e3df"></rect>
        <rect x="44" y="48" width="120" height="22" rx="11" fill="#d9f4ee"></rect>
        <rect x="44" y="84" width="170" height="12" rx="6" fill="#e2e8f0"></rect>
        <rect x="44" y="106" width="138" height="12" rx="6" fill="#e2e8f0"></rect>
        <circle cx="260" cy="96" r="46" fill="none" stroke="#e2e8f0" stroke-width="18"></circle>
        <circle cx="260" cy="96" r="46" fill="none" stroke="url(#dashGlow)" stroke-width="18" stroke-linecap="round" stroke-dasharray="214 75" transform="rotate(-90 260 96)"></circle>
        <path d="M56 178 C108 150, 146 194, 198 152 S270 132, 306 96" fill="none" stroke="url(#dashWarm)" stroke-width="8" stroke-linecap="round"></path>
        <circle cx="56" cy="178" r="7" fill="#f59e0b"></circle>
        <circle cx="198" cy="152" r="7" fill="#fb7185"></circle>
        <circle cx="306" cy="96" r="7" fill="#0ea5e9"></circle>
      </svg>
    </div>
  </section>

  <section class="grid grid--4 dashboard-metrics">
    <article class="card card--padded metric-card metric-card--teal">
      <span class="metric-card__label">Notas analisadas</span>
      <strong class="metric-card__value" id="stat-invoices">--</strong>
      <p class="metric-card__detail" id="stat-invoices-detail">Lendo historico recente...</p>
    </article>

    <article class="card card--padded metric-card metric-card--sky">
      <span class="metric-card__label">Produtos consultaveis</span>
      <strong class="metric-card__value" id="stat-products">--</strong>
      <p class="metric-card__detail" id="stat-products-detail">Medindo memoria fiscal...</p>
    </article>

    <article class="card card--padded metric-card metric-card--amber">
      <span class="metric-card__label">Empresa ativa</span>
      <strong class="metric-card__value metric-card__value--sm" id="stat-organization">--</strong>
      <p class="metric-card__detail" id="stat-organization-detail">Buscando contexto da sessao...</p>
    </article>

    <article class="card card--padded metric-card metric-card--slate">
      <span class="metric-card__label">API fiscal</span>
      <strong class="metric-card__value metric-card__value--sm" id="stat-api">--</strong>
      <p class="metric-card__detail" id="stat-api-detail">Verificando saude da plataforma...</p>
    </article>
  </section>

  <section class="dashboard-command-center">
    <article class="command-card command-card--primary">
      <span>Proximo passo recomendado</span>
      <strong id="next-action-title">Carregando...</strong>
      <p id="next-action-detail">Vamos decidir se o melhor caminho agora e consultar, importar XML ou revisar a base.</p>
      <a id="next-action-link" class="button-link" href="/simulacao">Abrir consulta</a>
    </article>
    <article class="command-card">
      <span>Contexto operacional</span>
      <strong id="context-summary">Empresa e regime</strong>
      <p id="context-detail">As sugestoes usam UF e regime tributario da organizacao ativa.</p>
    </article>
    <article class="command-card">
      <span>Ultima nota lida</span>
      <strong id="stat-last-issued">--</strong>
      <p id="stat-last-issued-detail">Aguardando leitura da base...</p>
    </article>
  </section>

  <section class="grid grid--2 dashboard-insights">
    <article class="card card--padded">
      <div class="panel-head">
        <div>
          <span class="panel-head__kicker">Memoria fiscal</span>
          <h3 class="section-title">Cobertura dos produtos</h3>
        </div>
      </div>
      <div id="dashboard-pulse" class="dashboard-note">Carregando sinais da operacao...</div>
    </article>

    <article class="card card--padded">
      <div class="panel-head">
        <div>
          <span class="panel-head__kicker">Portas de entrada</span>
          <h3 class="section-title">Rotas mais usadas</h3>
        </div>
      </div>
      <div class="quick-actions-grid">
        <a class="quick-action-card" href="/simulacao" data-filter-item>
          <span class="quick-action-card__tag">Descricao, GTIN ou NCM</span>
          <strong>Consulta assistida</strong>
          <p>Monte a sugestao tributaria completa com base no contexto operacional e no catalogo.</p>
        </a>
        <a class="quick-action-card" href="/invoices" data-filter-item>
          <span class="quick-action-card__tag">A partir da nota</span>
          <strong>Notas importadas</strong>
          <p>Abra a NF-e, revise os itens capturados e aproveite a memoria fiscal observada na entrada.</p>
        </a>
        <a class="quick-action-card" href="/ncm" data-filter-item>
          <span class="quick-action-card__tag">Tabela oficial</span>
          <strong>Consulta por NCM</strong>
          <p>Pesquise classificacao fiscal e use a base oficial para apoiar a decisao tributaria.</p>
        </a>
        <a class="quick-action-card" href="/produtos" data-filter-item>
          <span class="quick-action-card__tag">Base consultavel</span>
          <strong>Catalogo de produtos</strong>
          <p>Consulte a memoria tributaria consolidada dos produtos cadastrados e sua cobertura fiscal.</p>
        </a>
      </div>
    </article>
  </section>

  <section class="grid grid--3 dashboard-entry-points">
    <article class="card card--padded entry-card entry-card--teal" data-filter-item>
      <span class="entry-card__eyebrow">Consulta imediata</span>
      <h3>Quando ja sei o item</h3>
      <p>Use descricao, GTIN ou NCM para encontrar rapidamente a tributacao sugerida.</p>
      <a class="button-soft" href="/simulacao">Abrir consulta</a>
    </article>

    <article class="card card--padded entry-card entry-card--amber" data-filter-item>
      <span class="entry-card__eyebrow">Leitura documental</span>
      <h3>Quando recebi uma NF-e</h3>
      <p>Importe o XML, abra os itens da nota e transforme a entrada em conhecimento tributario reutilizavel.</p>
      <a class="button-soft" href="/importacoes">Importar XML</a>
    </article>

    <article class="card card--padded entry-card entry-card--sky" data-filter-item>
      <span class="entry-card__eyebrow">Consulta de base</span>
      <h3>Quando quero confirmar cadastro</h3>
      <p>Navegue pelo catalogo para conferir NCM, CEST, CFOP, CST e tributos da reforma ja consolidados.</p>
      <a class="button-soft" href="/produtos">Abrir catalogo</a>
    </article>
  </section>

  <section class="card card--padded" style="margin-top: 18px;">
    <div class="panel-head panel-head--spread">
      <div>
        <span class="panel-head__kicker">Base recente</span>
        <h3 class="section-title">Ultimas notas disponiveis para consulta</h3>
      </div>
      <a class="button-soft" href="/invoices">Ver todas</a>
    </div>
    <div id="dashboard-result" class="dashboard-note">Carregando dados...</div>
  </section>

  

  <script>
    import { apiFetch } from "../../lib/api";
    import { listCatalogProducts } from "../../lib/catalog-products";
    import { listInvoices } from "../../lib/invoices";
    import { listOrganizations } from "../../lib/organizations";

    const statInvoices = document.getElementById("stat-invoices");
    const statInvoicesDetail = document.getElementById("stat-invoices-detail");
    const statProducts = document.getElementById("stat-products");
    const statProductsDetail = document.getElementById("stat-products-detail");
    const statOrganization = document.getElementById("stat-organization");
    const statOrganizationDetail = document.getElementById("stat-organization-detail");
    const statAPI = document.getElementById("stat-api");
    const statAPIDetail = document.getElementById("stat-api-detail");
    const statLastIssued = document.getElementById("stat-last-issued");
    const statLastIssuedDetail = document.getElementById("stat-last-issued-detail");
    const nextActionTitle = document.getElementById("next-action-title");
    const nextActionDetail = document.getElementById("next-action-detail");
    const nextActionLink = document.getElementById("next-action-link");
    const contextSummary = document.getElementById("context-summary");
    const contextDetail = document.getElementById("context-detail");
    const pulse = document.getElementById("dashboard-pulse");
    const result = document.getElementById("dashboard-result");
    const adminLink = document.querySelector(".dashboard-admin-link");

    interface Invoice {
      id: string;
      number: string;
      series: string;
      emitter_name: string;
      issued_at: string;
      total_amount: string;
      status: string;
    }

    interface Organization {
      id: string;
      name: string;
      cnpj: string;
      role?: string;
      uf?: string;
      tax_regime?: string;
      crt?: string;
    }

    interface CatalogProduct {
      id: string;
      gtin?: string;
      description?: string;
      profile?: {
        ncm?: string;
        cest?: string;
        cfop?: string;
        csosn?: string;
        icms_cst?: string;
        pis_cst?: string;
        cofins_cst?: string;
        cclas_trib?: string;
      };
    }

    function formatDate(value?: string) {
      if (!value) return "-";

      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) {
        return value;
      }

      return new Intl.DateTimeFormat("pt-BR", {
        dateStyle: "short",
        timeStyle: "short",
      }).format(parsed);
    }

    function percentage(count: number, total: number) {
      if (!total) return 0;
      return Math.round((count / total) * 100);
    }

    function getStatusBadge(status?: string) {
      const normalized = String(status || "").toLowerCase();
      if (normalized.includes("process") || normalized.includes("success")) {
        return '<span class="badge badge--success">Processada</span>';
      }
      if (normalized.includes("pending")) {
        return '<span class="badge badge--warning">Pendente</span>';
      }
      if (normalized.includes("error") || normalized.includes("fail")) {
        return '<span class="badge badge--danger">Com erro</span>';
      }
      return `<span class="badge badge--info">${status || "Sem status"}</span>`;
    }

    function hasAdminAreaAccess(role?: string) {
      const normalized = String(role || "").toLowerCase();
      return normalized === "owner" || normalized === "admin" || normalized === "analyst";
    }

    function renderNextAction(invoices: Invoice[], products: CatalogProduct[]) {
      if (!nextActionTitle || !nextActionDetail || !(nextActionLink instanceof HTMLAnchorElement)) return;

      if (!products.length && !invoices.length) {
        nextActionTitle.textContent = "Importe uma NF-e para iniciar a base";
        nextActionDetail.textContent = "O XML cadastra produtos rapidamente e alimenta a consulta tributaria.";
        nextActionLink.href = "/importacoes";
        nextActionLink.textContent = "Importar XML";
        return;
      }

      if (products.length < 10) {
        nextActionTitle.textContent = "Aumente a memoria de produtos";
        nextActionDetail.textContent = "Importe mais notas ou revise produtos para melhorar a cobertura das sugestoes.";
        nextActionLink.href = "/produtos";
        nextActionLink.textContent = "Abrir catalogo";
        return;
      }

      nextActionTitle.textContent = "Consulte tributos com a base atual";
      nextActionDetail.textContent = "A memoria fiscal ja tem volume para consultas por descricao, GTIN ou NCM.";
      nextActionLink.href = "/simulacao";
      nextActionLink.textContent = "Consultar tributos";
    }

    function renderPulse(invoices: Invoice[], products: CatalogProduct[]) {
      if (!pulse) return;

      const total = products.length;
      const withGTIN = products.filter((product) => String(product.gtin || "").trim() !== "").length;
      const withNCM = products.filter((product) => String(product.profile?.ncm || "").trim() !== "").length;
      const withCEST = products.filter((product) => String(product.profile?.cest || "").trim() !== "").length;
      const withTax = products.filter((product) =>
        Boolean(product.profile?.csosn || product.profile?.icms_cst || product.profile?.pis_cst || product.profile?.cofins_cst)
      ).length;
      const readiness = Math.round((percentage(withGTIN, total) + percentage(withNCM, total) + percentage(withTax, total)) / 3);

      const processed = invoices.filter((invoice) =>
        String(invoice.status || "").toLowerCase().includes("process")
      ).length;
      const uniqueEmitters = new Set(
        invoices.map((invoice) => String(invoice.emitter_name || "").trim()).filter(Boolean)
      ).size;

      const strips = [
        { label: "Produtos com GTIN", count: withGTIN },
        { label: "Produtos com NCM", count: withNCM },
        { label: "Produtos com CEST", count: withCEST },
        { label: "Produtos com tributacao", count: withTax },
      ];

      pulse.innerHTML = `
        <div class="pulse-grid">
          <div class="pulse-grid__headline">
            <div class="pulse-score">${readiness}%</div>
            <div>
              <strong>${readiness >= 80 ? "Base forte para consulta" : readiness >= 50 ? "Base em evolucao" : "Base inicial"}</strong>
              <p>${products.length} produto(s) consultaveis, ${invoices.length} nota(s) importada(s) e ${processed} nota(s) processada(s).</p>
            </div>
          </div>
          ${strips
            .map((strip) => {
              const fill = percentage(strip.count, total);
              return `
                <div class="pulse-strip">
                  <div class="pulse-strip__head">
                    <span>${strip.label}</span>
                    <span>${strip.count}/${total}</span>
                  </div>
                  <div class="pulse-strip__track">
                    <div class="pulse-strip__fill" style="width:${fill}%"></div>
                  </div>
                </div>
              `;
            })
            .join("")}
          <div class="pulse-summary">
            <div class="pulse-summary__card">
              <span>Emissores distintos</span>
              <strong>${uniqueEmitters || 0}</strong>
            </div>
            <div class="pulse-summary__card">
              <span>Ritmo da base</span>
              <strong>${products.length >= 100 ? "Forte" : products.length >= 20 ? "Moderado" : "Inicial"}</strong>
            </div>
          </div>
        </div>
      `;
    }

    async function loadDashboard() {
      const token = localStorage.getItem("token");
      const organizationId = localStorage.getItem("organization_id");

      if (!token) {
        window.location.href = "/login";
        return;
      }

      if (!organizationId) {
        window.location.href = "/organizations";
        return;
      }

      try {
        await apiFetch("/health", { method: "GET" });
        if (statAPI) statAPI.textContent = "Online";
        if (statAPIDetail) statAPIDetail.textContent = "API respondeu com sucesso ao healthcheck.";

        const [invoiceData, organizationData, productData] = await Promise.all([
          listInvoices(),
          listOrganizations(),
          listCatalogProducts("", { limit: 500, offset: 0 }),
        ]);

        const invoices: Invoice[] = invoiceData.invoices || [];
        const organizations: Organization[] = organizationData.organizations || [];
        const products: CatalogProduct[] = productData.items || [];
        const activeOrganization =
          organizations.find((organization) => organization.id === organizationId) || null;
        const adminArea = hasAdminAreaAccess(activeOrganization?.role);
        const latestInvoice = [...invoices]
          .filter((invoice) => invoice.issued_at)
          .sort((left, right) => new Date(right.issued_at).getTime() - new Date(left.issued_at).getTime())[0];

        if (adminLink instanceof HTMLElement) {
          adminLink.style.display = adminArea ? "inline-flex" : "none";
        }

        if (statInvoices) statInvoices.textContent = String(invoices.length);
        if (statInvoicesDetail) {
          statInvoicesDetail.textContent =
            invoices.length > 0
              ? `${Math.min(invoices.length, 5)} ultimas notas destacadas abaixo.`
              : "Importe XMLs para ativar as consultas por documento.";
        }

        if (statProducts) statProducts.textContent = String(products.length);
        if (statProductsDetail) {
          statProductsDetail.textContent =
            products.length > 0
              ? `${products.filter((product) => product.profile?.ncm).length} com NCM e ${products.filter((product) => product.profile?.cest).length} com CEST.`
              : "Importe notas para cadastrar produtos automaticamente.";
        }

        if (statOrganization) statOrganization.textContent = activeOrganization?.name || "Nao encontrada";
        if (statOrganizationDetail) {
          statOrganizationDetail.textContent = activeOrganization?.cnpj
            ? `CNPJ ${activeOrganization.cnpj}${activeOrganization.role ? ` - ${activeOrganization.role}` : ""}`
            : "Sessao sem contexto de empresa completo.";
        }

        if (contextSummary) {
          contextSummary.textContent = activeOrganization
            ? `${activeOrganization.uf || "UF nao definida"} · ${activeOrganization.tax_regime || "Regime nao definido"}`
            : "Contexto nao encontrado";
        }
        if (contextDetail) {
          contextDetail.textContent = activeOrganization?.crt
            ? `CRT ${activeOrganization.crt}. As sugestoes usam esses dados como padrao de saida.`
            : "Complete UF, regime e CRT em Organizacoes para melhorar o motor.";
        }

        if (statLastIssued) statLastIssued.textContent = latestInvoice ? formatDate(latestInvoice.issued_at) : "--";
        if (statLastIssuedDetail) {
          statLastIssuedDetail.textContent = latestInvoice
            ? `Ultima nota do emitente ${latestInvoice.emitter_name || "-"}`
            : "Nenhuma emissao localizada na base atual.";
        }

        renderNextAction(invoices, products);
        renderPulse(invoices, products);

        if (!result) return;

        if (!invoices.length) {
          result.innerHTML = `
            <div class="empty-state">
              <strong>Nenhuma nota importada ainda.</strong>
              <p>Use a tela de <a class="dashboard-table-link" href="/importacoes">importacoes</a> para carregar o primeiro XML e ativar as consultas por nota.</p>
            </div>
          `;
          return;
        }

        const rows = invoices
          .slice(0, 6)
          .map(
            (invoice: Invoice) => `
              <tr>
                <td>${invoice.number || "-"}</td>
                <td>${invoice.series || "-"}</td>
                <td>${invoice.emitter_name || "-"}</td>
                <td>${formatDate(invoice.issued_at)}</td>
                <td>${getStatusBadge(invoice.status)}</td>
                <td><a class="dashboard-table-link" href="/invoices/${invoice.id}">Abrir</a></td>
              </tr>
            `
          )
          .join("");

        result.innerHTML = `
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Numero</th>
                  <th>Serie</th>
                  <th>Emitente</th>
                  <th>Emissao</th>
                  <th>Status</th>
                  <th>Acao</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
        `;
      } catch (error) {
        if (statAPI) statAPI.textContent = "Erro";
        if (statAPIDetail) statAPIDetail.textContent = "Falha ao consultar o backend.";

        if (pulse) {
          pulse.innerHTML = `
            <div class="empty-state">
              <strong>Falha ao montar os sinais da operacao.</strong>
              <p>${String(error)}</p>
            </div>
          `;
        }

        if (result) {
          result.innerHTML = `
            <div class="empty-state">
              <strong>Erro ao carregar a dashboard.</strong>
              <p>${String(error)}</p>
            </div>
          `;
        }
      }
    }

    loadDashboard();
  </script>
</AppLayout>
