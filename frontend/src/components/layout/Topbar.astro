---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle = "Portal de consulta tributaria com memoria fiscal, importacao de notas e apoio a decisao" } = Astro.props;
---

<header class="topbar">
  <div class="topbar__title">
    <span class="topbar__eyebrow">Portal tributario</span>
    <h1>{title}</h1>
    <p>{subtitle}</p>
  </div>

  <div class="topbar__actions">
    <span class="topbar-mode-chip" id="topbar-mode-chip">Fluxo operacional</span>
    <a class="search-box topbar-link" id="topbar-primary-link" href="/simulacao">Nova consulta</a>
    <a class="user-chip topbar-link" id="session-chip" href="/login">Sessao nao autenticada</a>
  </div>
</header>

<script>
  function updateTopbarContext() {
    const chip = document.getElementById("session-chip");
    const modeChip = document.getElementById("topbar-mode-chip");
    const primaryLink = document.getElementById("topbar-primary-link");
    if (!chip || !modeChip || !primaryLink) return;

    let token = null;
    let organizationId = null;
    let role = null;

    try {
      token = localStorage.getItem("token");
      organizationId = localStorage.getItem("organization_id");
      role = localStorage.getItem("organization_role");
    } catch {
      token = null;
      organizationId = null;
      role = null;
    }

    const normalizedRole = String(role || "").toLowerCase();
    const hasAdminArea = normalizedRole === "owner" || normalizedRole === "admin" || normalizedRole === "analyst";
    const currentPath = window.location.pathname;
    const inEngineeringFlow = currentPath.startsWith("/admin");

    document.body.dataset.userScope = inEngineeringFlow && hasAdminArea ? "admin" : "operational";

    modeChip.textContent = inEngineeringFlow && hasAdminArea ? "Engenharia fiscal" : "Consulta operacional";
    modeChip.className = `topbar-mode-chip ${inEngineeringFlow && hasAdminArea ? "topbar-mode-chip--admin" : "topbar-mode-chip--operational"}`;
    primaryLink.textContent = inEngineeringFlow && hasAdminArea ? "Abrir consulta" : "Nova consulta";
    primaryLink.setAttribute("href", inEngineeringFlow && hasAdminArea ? "/simulacao" : "/simulacao");

    if (!token) {
      chip.textContent = "Entrar";
      chip.setAttribute("href", "/login");
      return;
    }

    chip.textContent = organizationId ? `Empresa ativa: ${organizationId}` : "Selecionar empresa";
    chip.setAttribute("href", "/organizations");
  }

  updateTopbarContext();
</script>
