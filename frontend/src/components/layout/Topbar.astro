---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle = "Plataforma de inteligencia tributaria" } = Astro.props;
---

<header class="topbar">
  <div class="topbar__identity">
    <img class="topbar__mark" src="/brand-mark.svg" alt="" width="42" height="42" loading="eager" />
    <div class="topbar__title">
      <span class="topbar__eyebrow" id="topbar-eyebrow">Workspace</span>
      <h1>{title}</h1>
      <p>{subtitle}</p>
    </div>
  </div>

  <div class="topbar__actions">
    <a class="topbar-action topbar-action--primary" id="topbar-primary-link" href="/simulacao">Nova consulta</a>
    <a class="topbar-action" id="topbar-secondary-link" href="/admin">Matriz fiscal</a>
    <a class="topbar-user" id="session-chip" href="/login">Entrar</a>
  </div>
</header>

<script>
  function updateTopbarContext() {
    const chip = document.getElementById("session-chip");
    const eyebrow = document.getElementById("topbar-eyebrow");
    const primaryLink = document.getElementById("topbar-primary-link");
    const secondaryLink = document.getElementById("topbar-secondary-link");
    if (!chip || !eyebrow || !primaryLink || !secondaryLink) return;

    let token = null;
    let organizationId = null;
    let role = null;

    try {
      token = localStorage.getItem("token");
      organizationId = localStorage.getItem("organization_id");
      role = localStorage.getItem("organization_role");
    } catch {
      token = null;
      organizationId = null;
      role = null;
    }

    const currentPath = window.location.pathname;
    const normalizedRole = String(role || "").toLowerCase();
    const hasAdminArea =
      normalizedRole === "owner" || normalizedRole === "admin" || normalizedRole === "analyst";
    const inAdmin = currentPath.startsWith("/admin");

    eyebrow.textContent = inAdmin ? "Fiscal Lab" : "Cliente";

    primaryLink.textContent = inAdmin ? "Abrir consulta" : "Nova consulta";
    primaryLink.setAttribute("href", "/simulacao");

    secondaryLink.textContent = inAdmin ? "Dashboard" : "Matriz fiscal";
    secondaryLink.setAttribute("href", inAdmin ? "/" : "/admin");
    secondaryLink.hidden = !hasAdminArea;

    if (!token) {
      chip.textContent = "Entrar";
      chip.setAttribute("href", "/login");
      return;
    }

    chip.textContent = organizationId ? "Empresa ativa" : "Selecionar empresa";
    chip.setAttribute("href", "/organizations");
  }

  updateTopbarContext();
</script>
