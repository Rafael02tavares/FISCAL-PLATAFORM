---
const currentPath = Astro.url.pathname;

type NavItem = {
  href: string;
  label: string;
  adminOnly?: boolean;
};

type NavSection = {
  title: string;
  adminOnly?: boolean;
  items: NavItem[];
};

const workspaces = [
  { href: "/", label: "Cliente", description: "consulta e operacao", adminOnly: false },
  { href: "/admin", label: "Fiscal Lab", description: "engenharia e governanca", adminOnly: true },
];

const sections: NavSection[] = [
  {
    title: "Consulta",
    items: [
      { href: "/", label: "Dashboard" },
      { href: "/simulacao", label: "Simulacao tributaria" },
      { href: "/produtos", label: "Produtos" },
      { href: "/invoices", label: "Notas fiscais" },
      { href: "/importacoes", label: "Importacoes" },
    ],
  },
  {
    title: "Base fiscal",
    items: [
      { href: "/ncm", label: "NCM" },
      { href: "/cest", label: "CEST" },
      { href: "/cfop", label: "CFOP" },
      { href: "/organizations", label: "Empresa ativa" },
    ],
  },
  {
    title: "Tributos",
    adminOnly: true,
    items: [
      { href: "/admin", label: "Matriz fiscal", adminOnly: true },
      { href: "/admin/icms", label: "ICMS", adminOnly: true },
      { href: "/admin/pis-cofins", label: "PIS e COFINS", adminOnly: true },
      { href: "/admin/reforma", label: "IBS, CBS e cClasTrib", adminOnly: true },
    ],
  },
  {
    title: "Motor",
    adminOnly: true,
    items: [
      { href: "/admin/legal-rules", label: "Regras fiscais", adminOnly: true },
      { href: "/admin/capture-rules", label: "Triagem", adminOnly: true },
      { href: "/admin/cst", label: "CST e enquadramentos", adminOnly: true },
      { href: "/admin/icms-partilha", label: "Partilha de ICMS", adminOnly: true },
      { href: "/admin/cbenef", label: "cBenef", adminOnly: true },
    ],
  },
  {
    title: "Plataforma",
    adminOnly: true,
    items: [
      { href: "/admin/fiscal-watcher", label: "Fiscal Watcher", adminOnly: true },
      { href: "/admin/imports", label: "Importacoes oficiais", adminOnly: true },
      { href: "/admin/users", label: "Usuarios e acessos", adminOnly: true },
      { href: "/configuracoes", label: "Configuracoes", adminOnly: true },
    ],
  },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

function isWorkspaceActive(href: string) {
  if (href === "/admin") return currentPath.startsWith("/admin");
  return !currentPath.startsWith("/admin");
}
---

<aside class="sidebar">
  <a class="sidebar__brand" href="/" aria-label="Fiscal Platform">
    <img class="sidebar__brand-mark" src="/brand-mark.svg" alt="" width="54" height="54" loading="eager" />
    <span class="sidebar__brand-copy">
      <span class="sidebar__brand-kicker">Fiscal Platform</span>
      <span class="sidebar__brand-title">Inteligencia tributaria</span>
    </span>
  </a>

  <div class="sidebar__workspace-picker">
    {workspaces.map((workspace) => (
      <a
        href={workspace.href}
        class={`sidebar__workspace ${isWorkspaceActive(workspace.href) ? "sidebar__workspace--active" : ""}`}
        data-workspace-role={workspace.adminOnly ? "admin" : "all"}
      >
        <strong>{workspace.label}</strong>
        <span>{workspace.description}</span>
      </a>
    ))}
  </div>

  <div class="sidebar__panel">
    {sections.map((section) => (
      <section
        class="sidebar__section"
        data-section-role={section.adminOnly ? "admin" : "all"}
      >
        <header class="sidebar__section-head">
          <span>{section.title}</span>
        </header>

        <nav class="sidebar__nav" aria-label={section.title}>
          {section.items.map((item) => (
            <a
              href={item.href}
              class={`sidebar__link ${isActive(item.href) ? "sidebar__link--active" : ""}`}
              data-link-role={item.adminOnly ? "admin" : "all"}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </section>
    ))}
  </div>
</aside>

<script>
  function updateSidebarSections() {
    let role = null;

    try {
      role = localStorage.getItem("organization_role");
    } catch {
      role = null;
    }

    const normalizedRole = String(role || "").toLowerCase();
    const hasAdminArea =
      normalizedRole === "owner" || normalizedRole === "admin" || normalizedRole === "analyst";

    document.querySelectorAll("[data-section-role='admin']").forEach((element) => {
      if (element instanceof HTMLElement) element.hidden = !hasAdminArea;
    });

    document.querySelectorAll("[data-link-role='admin']").forEach((element) => {
      if (element instanceof HTMLElement) element.hidden = !hasAdminArea;
    });

    document.querySelectorAll("[data-workspace-role='admin']").forEach((element) => {
      if (element instanceof HTMLElement) element.hidden = !hasAdminArea;
    });
  }

  updateSidebarSections();
</script>
