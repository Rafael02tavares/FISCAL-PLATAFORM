---
import Sidebar from "./Sidebar.astro";
import Topbar from "./Topbar.astro";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="app-shell">
  <Sidebar />

  <main class="main">
    <div class="main__backdrop" aria-hidden="true">
      <span class="main__orb main__orb--teal"></span>
      <span class="main__orb main__orb--amber"></span>
      <span class="main__grid"></span>
    </div>
    <Topbar title={title} subtitle={subtitle} />
    <section class="content" data-filter-root>
      <div class="page-filter" data-page-filter>
        <label class="page-filter__field">
          <span class="page-filter__label">Filtro</span>
          <input
            type="search"
            placeholder={`Filtrar ${title.toLowerCase()} por nome, codigo, UF, regra ou descricao`}
            data-global-filter-input
          />
        </label>
        <button type="button" class="page-filter__clear" data-global-filter-clear hidden>Limpar</button>
        <p class="page-filter__hint" data-global-filter-status>Pronto</p>
      </div>
      <slot />
    </section>
  </main>
</div>

<script type="module">
  function normalizeText(value) {
    return String(value || "")
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .toLowerCase()
      .trim();
  }

  function isNestedCandidate(element, selector) {
    const parent = element.parentElement?.closest(selector);
    return !!parent;
  }

  function collectCandidates(root) {
    const selector = [
      "[data-filter-item]",
      ".table tbody tr",
      ".list-item",
      ".quick-action-card",
      ".entry-card",
      ".admin-card",
      ".rule-card",
      ".state-rate-card",
      ".comparison-card",
      ".legal-chip",
      ".pulse-summary__card",
    ].join(", ");

    return Array.from(root.querySelectorAll(selector)).filter((element) => !isNestedCandidate(element, selector));
  }

  const root = document.querySelector("[data-filter-root]");
  const input = document.querySelector("[data-global-filter-input]");
  const clearButton = document.querySelector("[data-global-filter-clear]");
  const status = document.querySelector("[data-global-filter-status]");

  function applyFilter() {
    if (!(root instanceof HTMLElement) || !(input instanceof HTMLInputElement)) {
      return;
    }

    const query = normalizeText(input.value);
    const terms = query.split(/\s+/).filter(Boolean);
    const candidates = collectCandidates(root);

    if (clearButton instanceof HTMLButtonElement) {
      clearButton.hidden = !query;
    }

    if (!terms.length) {
      candidates.forEach((candidate) => {
        candidate.hidden = false;
      });

      if (status instanceof HTMLElement) {
        status.textContent = "Pronto";
      }
      return;
    }

    let visibleCount = 0;
    candidates.forEach((candidate) => {
      const text = normalizeText(candidate.getAttribute("data-filter-text") || candidate.textContent || "");
      const visible = terms.every((term) => text.includes(term));
      candidate.hidden = !visible;
      if (visible) {
        visibleCount += 1;
      }
    });

    if (status instanceof HTMLElement) {
      status.textContent =
        visibleCount > 0
          ? `${visibleCount} resultado(s)`
          : "Sem resultados";
    }
  }

  input?.addEventListener("input", applyFilter);
  clearButton?.addEventListener("click", () => {
    if (!(input instanceof HTMLInputElement)) {
      return;
    }
    input.value = "";
    applyFilter();
    input.focus();
  });
</script>
