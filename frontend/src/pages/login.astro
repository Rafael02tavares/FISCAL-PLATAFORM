---
const title = "Entrar";
import loginScript from "../scripts/login.ts?url";
import "../components/styles/global.css";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/brand-mark.svg" />
    <title>{title}</title>
  </head>
  <body class="m-0 min-h-screen font-sans text-slate-900 bg-[#eef4ff] flex items-center justify-center p-6" style="background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.18), transparent 28%), radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.16), transparent 24%), linear-gradient(180deg, #f7fbff 0%, #edf3ff 100%);">
    
    <section class="w-full max-w-[1040px] grid grid-cols-1 md:grid-cols-[1.05fr_0.95fr] rounded-[28px] overflow-hidden bg-white shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
      
      <aside class="relative overflow-hidden p-6 md:p-10 text-blue-50 bg-blue-700" style="background: linear-gradient(160deg, rgba(29, 78, 216, 0.96), rgba(14, 116, 144, 0.88)), #1d4ed8;">
        <!-- decorative shape -->
        <div class="absolute -right-[76px] -bottom-[86px] w-[240px] h-[240px] rounded-full bg-[#f2b84b33]"></div>
        
        <div class="relative z-10 flex items-center gap-3.5 mb-7">
          <img src="/brand-mark.svg" alt="" width="62" height="62" class="w-[62px] h-[62px] rounded-[18px] shadow-[0_18px_44px_rgba(8,20,29,0.24)]" />
          <div>
            <span class="block text-blue-100/70 text-[11px] font-extrabold tracking-[0.16em] uppercase">Fiscal Platform</span>
            <strong class="block mt-1 text-white text-2xl leading-none">Motor tributario</strong>
          </div>
        </div>
        
        <h1 class="relative z-10 m-0 mb-3.5 text-[34px] leading-[1.1] font-display">Fiscal Platform</h1>
        <p class="relative z-10 m-0 text-blue-50/90 max-w-[38ch]">
          Entre com sua conta para acessar organizacoes, importar notas e alimentar a dashboard
          com dados reais do ambiente.
        </p>
        
        <div class="relative z-10 mt-7 grid gap-3.5">
          <div class="bg-white/10 border border-white/15 rounded-[18px] px-[18px] py-4">
            <strong class="block mb-1.5 font-bold">1. Autentique</strong>
            <span class="text-sm">O token da API e salvo no navegador para as rotas protegidas.</span>
          </div>
          <div class="bg-white/10 border border-white/15 rounded-[18px] px-[18px] py-4">
            <strong class="block mb-1.5 font-bold">2. Escolha a organizacao</strong>
            <span class="text-sm">Depois do login, selecione a empresa ativa para consultar invoices.</span>
          </div>
          <div class="bg-white/10 border border-white/15 rounded-[18px] px-[18px] py-4">
            <strong class="block mb-1.5 font-bold">3. Volte para a dashboard</strong>
            <span class="text-sm">Com sessao e organizacao definidas, os cards passam a ler dados reais.</span>
          </div>
        </div>
      </aside>

      <main class="p-6 md:p-[34px_32px]">
        <div class="inline-grid grid-cols-2 bg-slate-50 rounded-full p-1 mb-5" role="tablist" aria-label="Autenticacao">
          <a class="auth-tab text-center border-none bg-transparent text-slate-500 py-2.5 px-4 rounded-full cursor-pointer font-semibold data-[active=true]:bg-white data-[active=true]:text-slate-900 data-[active=true]:shadow-[0_6px_18px_rgba(15,23,42,0.08)] transition-all" href="#login-form" data-target="login-form" aria-selected="true" data-active="true">
            Entrar
          </a>
          <a class="auth-tab text-center border-none bg-transparent text-slate-500 py-2.5 px-4 rounded-full cursor-pointer font-semibold data-[active=true]:bg-white data-[active=true]:text-slate-900 data-[active=true]:shadow-[0_6px_18px_rgba(15,23,42,0.08)] transition-all" href="#register-form" data-target="register-form" aria-selected="false" data-active="false">
            Cadastrar
          </a>
        </div>

        <div id="auth-message" class="hidden min-h-[48px] rounded-[14px] p-3 text-sm [&.is-visible]:block [&.is-error]:bg-rose-50 [&.is-error]:text-red-600 [&.is-success]:bg-emerald-50 [&.is-success]:text-green-700" aria-live="polite"></div>

        <form id="login-form" class="grid gap-3.5" novalidate>
          <h2 class="m-0 text-2xl font-display">Acessar conta</h2>
          <p class="m-0 mb-1.5 text-slate-500 text-sm">Use o email e a senha cadastrados para gerar o token de acesso.</p>
          
          <label class="grid gap-2 font-semibold text-sm">
            Email
            <input id="login-email" class="w-full border border-slate-200 rounded-[14px] px-3.5 py-3 [font:inherit] focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" type="email" placeholder="voce@empresa.com" autocomplete="email" required />
          </label>
          <label class="grid gap-2 font-semibold text-sm">
            Senha
            <input id="login-password" class="w-full border border-slate-200 rounded-[14px] px-3.5 py-3 [font:inherit] focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" type="password" placeholder="Sua senha" autocomplete="current-password" required />
          </label>
          
          <div class="flex gap-3 items-center flex-wrap mt-2">
            <button class="border-none rounded-[14px] px-[18px] py-[13px] bg-blue-700 text-white font-bold cursor-pointer hover:bg-blue-800 disabled:opacity-70 disabled:cursor-wait transition-colors" type="submit" id="login-submit">Entrar</button>
            <a class="border border-blue-700/20 rounded-[14px] px-[18px] py-[13px] bg-transparent text-blue-700 font-bold hover:bg-blue-50 transition-colors" href="/">Voltar para a dashboard</a>
          </div>
        </form>

        <form id="register-form" class="hidden gap-3.5" novalidate>
          <h2 class="m-0 text-2xl font-display">Criar conta</h2>
          <p class="m-0 mb-1.5 text-slate-500 text-sm">Cadastre um usuario novo para comecar a usar o ambiente local.</p>
          
          <label class="grid gap-2 font-semibold text-sm">
            Nome
            <input id="register-name" class="w-full border border-slate-200 rounded-[14px] px-3.5 py-3 [font:inherit] focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" type="text" placeholder="Nome do responsavel" autocomplete="name" required />
          </label>
          <label class="grid gap-2 font-semibold text-sm">
            Email
            <input id="register-email" class="w-full border border-slate-200 rounded-[14px] px-3.5 py-3 [font:inherit] focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600" type="email" placeholder="voce@empresa.com" autocomplete="email" required />
          </label>
          <label class="grid gap-2 font-semibold text-sm">
            Senha
            <input
              id="register-password"
              class="w-full border border-slate-200 rounded-[14px] px-3.5 py-3 [font:inherit] focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600"
              type="password"
              placeholder="Minimo de 6 caracteres"
              autocomplete="new-password"
              minlength="6"
              required
            />
          </label>
          <label class="grid gap-2 font-semibold text-sm">
            Confirmar senha
            <input
              id="register-password-confirm"
              class="w-full border border-slate-200 rounded-[14px] px-3.5 py-3 [font:inherit] focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600"
              type="password"
              placeholder="Repita a senha"
              autocomplete="new-password"
              minlength="6"
              required
            />
          </label>
          
          <div class="flex gap-3 items-center flex-wrap mt-2">
            <button class="border-none rounded-[14px] px-[18px] py-[13px] bg-blue-700 text-white font-bold cursor-pointer hover:bg-blue-800 disabled:opacity-70 disabled:cursor-wait transition-colors" type="submit" id="register-submit">Criar conta</button>
            <button class="border border-blue-700/20 rounded-[14px] px-[18px] py-[13px] bg-transparent text-blue-700 font-bold hover:bg-blue-50 transition-colors cursor-pointer" type="button" id="switch-to-login">
              Ja tenho conta
            </button>
          </div>
        </form>

        <p class="mt-[18px] text-slate-500 text-sm">
          Depois do login, siga para <a href="/organizations" class="text-blue-700 font-semibold hover:underline">Organizacoes</a> para definir o
          contexto ativo da dashboard.
        </p>
      </main>
    </section>

    <script type="module" src={loginScript}></script>
    <script>
      // Small script to handle the tab styling since we removed is-active class from global css 
      // Note: the loginScript handles display/hide of forms, but we need to toggle 'data-active' attribute for styling on tabs
      const tabs = document.querySelectorAll('.auth-tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          tabs.forEach(t => {
            t.setAttribute('data-active', 'false');
            t.classList.remove('is-active');
          });
          tab.setAttribute('data-active', 'true');
          tab.classList.add('is-active'); // keep is-active for compatibility with loginScript
        });
      });
    </script>
  </body>
</html>